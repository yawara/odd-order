import Mathlib.GroupTheory.FiniteAbelian.Basic
import Mathlib.LinearAlgebra.Matrix.Adjugate
import Mathlib.RingTheory.Ideal.Quotient.Defs

/-!
# Annihilators of modules with finite-index ideal multiples

Isaacs, *Finite Group Theory* (AMS GSM 92, 2008) §10C, Theorem 10.26
(pp. 315-316): let `A` be a module over a commutative ring `R`, `U ⊆ R` an
ideal, and suppose `A` and `U` are finitely generated as additive groups and
`UA` has finite index `m` in `A`.  Then there is `r ∈ R` with `rA = 0` and
`r ≡ m·1 mod U`.

* `smul_top_toAddSubgroup_fg` — `UA` is finitely generated as an additive
  group.
* `exists_ideal_coeffs_of_mem_smul_top` — elements of `UA` are `U`-linear
  combinations of any additive generating family of `A`.
* `det_smul_eq_zero_of_forall_sum_smul_eq_zero` — the classical-adjoint
  (adjugate) determinant trick.
* `sub_det_diagonal_mem_of_forall_mem` — `det(D - S) ≡ det D mod U` for `S`
  with entries in `U`.
* `exists_smul_eq_zero_and_sub_card_mem` — **Theorem 10.26**.

これは Theorem 10.25 (Furtwängler の principal ideal theorem,
`PrincipalIdealTheorem.lean`) の中核前提。mathlib の Nakayama 変種
(`Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul`) は
`m = 1` の特殊形のみなので独立に証明する。
-/

namespace OddOrder.Algebra

open scoped DirectSum

section FiniteIndexAnnihilator

variable {R : Type*} [CommRing R] {A : Type*} [AddCommGroup A] [Module R A]

/-- If the ideal `U` and the module `A` are finitely generated as additive
groups, then so is `U • A` (Isaacs p. 315: `UA` is generated by the products
`u b` of generators). -/
theorem smul_top_toAddSubgroup_fg (U : Ideal R)
    (hU : U.toAddSubgroup.FG) (hA : (⊤ : AddSubgroup A).FG) :
    (U • (⊤ : Submodule R A)).toAddSubgroup.FG := by
  classical
  obtain ⟨su, hsu⟩ := hU
  obtain ⟨sa, hsa⟩ := hA
  refine ⟨(su ×ˢ sa).image fun p => p.1 • p.2, le_antisymm ?_ ?_⟩
  · rw [AddSubgroup.closure_le]
    intro w hw
    rw [Finset.coe_image, Set.mem_image] at hw
    obtain ⟨⟨u, b⟩, hub, rfl⟩ := hw
    rw [Finset.mem_coe, Finset.mem_product] at hub
    have hu : u ∈ U := by
      rw [← U.mem_toAddSubgroup, ← hsu]
      exact AddSubgroup.subset_closure hub.1
    exact Submodule.smul_mem_smul hu Submodule.mem_top
  · intro w hw
    rw [Submodule.mem_toAddSubgroup] at hw
    refine Submodule.smul_induction_on hw (fun r hr x _ => ?_)
      (fun x y hx hy => AddSubgroup.add_mem _ hx hy)
    -- reduce `r` to the generators of `U`
    have hr' : r ∈ AddSubgroup.closure (su : Set R) := by
      rw [hsu]; exact U.mem_toAddSubgroup.mpr hr
    refine AddSubgroup.closure_induction
      (fun u hu => ?_) (by simp)
      (fun r₁ r₂ _ _ h₁ h₂ => by
        rw [add_smul]; exact AddSubgroup.add_mem _ h₁ h₂)
      (fun r₁ _ h₁ => by
        rw [neg_smul]; exact AddSubgroup.neg_mem _ h₁) hr'
    -- reduce `x` to the generators of `A`
    have hx' : x ∈ AddSubgroup.closure (sa : Set A) := by
      rw [hsa]; exact AddSubgroup.mem_top x
    refine AddSubgroup.closure_induction
      (fun b hb => AddSubgroup.subset_closure ?_)
      (by simp)
      (fun x₁ x₂ _ _ h₁ h₂ => by
        rw [smul_add]; exact AddSubgroup.add_mem _ h₁ h₂)
      (fun x₁ _ h₁ => by
        rw [smul_neg]; exact AddSubgroup.neg_mem _ h₁) hx'
    exact Finset.mem_image.mpr ⟨(u, b), Finset.mem_product.mpr ⟨hu, hb⟩, rfl⟩

/-- Every element of `UA` is a `U`-linear combination of any finite additive
generating family of `A` (Isaacs p. 315: `m_i a_i = ∑ s_{ij} a_j` with
`s_{ij} ∈ U`). -/
theorem exists_ideal_coeffs_of_mem_smul_top {U : Ideal R}
    {ι : Type*} [Fintype ι] {g : ι → A}
    (hgen : AddSubgroup.closure (Set.range g) = ⊤)
    {w : A} (hw : w ∈ U • (⊤ : Submodule R A)) :
    ∃ s : ι → R, (∀ j, s j ∈ U) ∧ w = ∑ j, s j • g j := by
  classical
  refine Submodule.smul_induction_on hw (fun r hr x _ => ?_) ?_
  · -- `r • x` with `r ∈ U`: induct on `x` over the additive generators
    have hx : x ∈ AddSubgroup.closure (Set.range g) := by
      rw [hgen]; exact AddSubgroup.mem_top x
    refine AddSubgroup.closure_induction (fun b hb => ?_) ?_ ?_ ?_ hx
    · obtain ⟨j, rfl⟩ := hb
      refine ⟨Pi.single j r, fun j' => ?_, ?_⟩
      · rcases eq_or_ne j' j with rfl | hne
        · rw [Pi.single_eq_same]; exact hr
        · rw [Pi.single_eq_of_ne hne]; exact U.zero_mem
      · rw [Finset.sum_eq_single j
          (fun j' _ hne => by rw [Pi.single_eq_of_ne hne, zero_smul])
          (fun h => absurd (Finset.mem_univ j) h), Pi.single_eq_same]
    · exact ⟨0, fun j => U.zero_mem, by simp⟩
    · rintro x₁ x₂ _ _ ⟨s₁, hs₁, he₁⟩ ⟨s₂, hs₂, he₂⟩
      refine ⟨s₁ + s₂, fun j => U.add_mem (hs₁ j) (hs₂ j), ?_⟩
      rw [smul_add, he₁, he₂, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun j _ => (add_smul _ _ _).symm
    · rintro x₁ _ ⟨s₁, hs₁, he₁⟩
      refine ⟨-s₁, fun j => U.neg_mem (hs₁ j), ?_⟩
      rw [smul_neg, he₁, ← Finset.sum_neg_distrib]
      exact Finset.sum_congr rfl fun j _ => (neg_smul _ _).symm
  · rintro x y ⟨s₁, hs₁, he₁⟩ ⟨s₂, hs₂, he₂⟩
    refine ⟨s₁ + s₂, fun j => U.add_mem (hs₁ j) (hs₂ j), ?_⟩
    rw [he₁, he₂, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun j _ => (add_smul _ _ _).symm

/-- The classical-adjoint trick (Isaacs p. 315): if `∑_j B_{ij} • g_j = 0`
for all `i`, then `det B` annihilates every `g_i`
(`0 = T(M-S)v = rIv = rv` with `T` the adjugate). -/
theorem det_smul_eq_zero_of_forall_sum_smul_eq_zero
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : Matrix ι ι R) (g : ι → A)
    (hrel : ∀ i, ∑ j, B i j • g j = 0) (i : ι) :
    B.det • g i = 0 := by
  have key : ∑ j, (B.adjugate * B) i j • g j = 0 := by
    calc ∑ j, (B.adjugate * B) i j • g j
        = ∑ j, ∑ k, (B.adjugate i k * B k j) • g j := by
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [Matrix.mul_apply, Finset.sum_smul]
      _ = ∑ k, ∑ j, (B.adjugate i k * B k j) • g j := Finset.sum_comm
      _ = ∑ k, B.adjugate i k • ∑ j, B k j • g j := by
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [Finset.smul_sum]
          exact Finset.sum_congr rfl fun j _ => mul_smul _ _ _
      _ = 0 := Finset.sum_eq_zero fun k _ => by rw [hrel k, smul_zero]
  rw [Matrix.adjugate_mul] at key
  have hone : ∑ j, (B.det • (1 : Matrix ι ι R)) i j • g j = B.det • g i := by
    rw [Finset.sum_eq_single i
      (fun j _ hne => by
        rw [Matrix.smul_apply, Matrix.one_apply_ne (Ne.symm hne), smul_zero,
          zero_smul])
      (fun h => absurd (Finset.mem_univ i) h),
      Matrix.smul_apply, Matrix.one_apply_eq, smul_eq_mul, mul_one]
  rw [← hone]
  exact key

/-- `det (D - S) ≡ det D mod U` when the entries of `S` lie in `U`
(Isaacs p. 316: expand the determinant modulo `U`). -/
theorem sub_det_diagonal_mem_of_forall_mem {U : Ideal R}
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (D S : Matrix ι ι R) (hS : ∀ i j, S i j ∈ U) :
    (D - S).det - D.det ∈ U := by
  have hmap : Ideal.Quotient.mk U (D - S).det = Ideal.Quotient.mk U D.det := by
    rw [RingHom.map_det, RingHom.map_det, RingHom.mapMatrix_apply,
      RingHom.mapMatrix_apply]
    congr 1
    ext i j
    rw [Matrix.map_apply, Matrix.map_apply, Matrix.sub_apply, map_sub,
      Ideal.Quotient.eq_zero_iff_mem.mpr (hS i j), sub_zero]
  exact Ideal.Quotient.eq.mp hmap

/-- **Isaacs Theorem 10.26** (p. 315): let `A` be a module over a commutative
ring `R` and `U ⊆ R` an ideal, with `A` and `U` finitely generated as
additive groups.  If `UA` has finite index `m` in `A`, then there exists
`r ∈ R` with `rA = 0` and `r ≡ m·1 mod U`. -/
theorem exists_smul_eq_zero_and_sub_card_mem (U : Ideal R)
    (hU : U.toAddSubgroup.FG) (hA : (⊤ : AddSubgroup A).FG)
    [Finite (A ⧸ (U • (⊤ : Submodule R A)))] :
    ∃ r : R, (∀ a : A, r • a = 0)
      ∧ r - (Nat.card (A ⧸ (U • (⊤ : Submodule R A))) : R) ∈ U := by
  classical
  -- cyclic decomposition of `A/UA` (structure theorem for finite abelian
  -- groups): generators `aᵢ` with `nᵢ • aᵢ ∈ UA` and `∏ nᵢ = m`
  obtain ⟨κ, hκ, n, hn1, ⟨e⟩⟩ :=
    AddCommGroup.equiv_directSum_zmod_of_finite'
      (A ⧸ (U • (⊤ : Submodule R A)))
  have hcard : Nat.card (A ⧸ (U • (⊤ : Submodule R A))) = ∏ i, n i := by
    have h1 : Nat.card (A ⧸ (U • (⊤ : Submodule R A)))
        = Nat.card (∀ i, ZMod (n i)) :=
      Nat.card_congr (e.toEquiv.trans DFinsupp.equivFunOnFintype)
    rw [h1, Nat.card_pi]
    exact Finset.prod_congr rfl fun i _ => Nat.card_zmod _
  choose lift hlift using
    Submodule.Quotient.mk_surjective (U • (⊤ : Submodule R A))
  set a : κ → A :=
    fun i => lift (e.symm (DirectSum.of (fun i => ZMod (n i)) i 1)) with ha
  -- additive generators of `UA`
  obtain ⟨sb, hsb⟩ := smul_top_toAddSubgroup_fg U hU hA
  -- the combined generating family
  set g : κ ⊕ {x // x ∈ sb} → A := Sum.elim a Subtype.val with hg
  set μ : κ ⊕ {x // x ∈ sb} → ℕ := Sum.elim n fun _ => 1 with hμ
  have hμg : ∀ i, (μ i : R) • g i ∈ U • (⊤ : Submodule R A) := by
    rintro (i | b)
    · have h1 : (Submodule.Quotient.mk (n i • a i) :
          A ⧸ (U • (⊤ : Submodule R A))) = 0 := by
        have h2 : n i • (1 : ZMod (n i)) = 0 := by
          rw [nsmul_eq_mul, mul_one, ZMod.natCast_self]
        calc (Submodule.Quotient.mk (n i • a i) :
              A ⧸ (U • (⊤ : Submodule R A)))
            = n i • (Submodule.Quotient.mk (a i) :
                A ⧸ (U • (⊤ : Submodule R A))) := by
              simp only [← Submodule.mkQ_apply, map_nsmul]
          _ = n i • e.symm (DirectSum.of (fun i => ZMod (n i)) i 1) := by
              simp only [ha]
              rw [hlift]
          _ = e.symm (DirectSum.of (fun i => ZMod (n i)) i
                (n i • (1 : ZMod (n i)))) := by
              rw [map_nsmul, map_nsmul]
          _ = 0 := by rw [h2, map_zero, map_zero]
      have h3 := (Submodule.Quotient.mk_eq_zero _).mp h1
      simpa [hg, hμ, Nat.cast_smul_eq_nsmul] using h3
    · have hb : (b : A) ∈ U • (⊤ : Submodule R A) := by
        rw [← Submodule.mem_toAddSubgroup, ← hsb]
        exact AddSubgroup.subset_closure b.2
      simpa [hg, hμ] using hb
  -- the family `g` generates `A` additively
  have hgen : AddSubgroup.closure (Set.range g) = ⊤ := by
    refine le_antisymm le_top fun y _ => ?_
    have hlift' : ∀ x : (⨁ i, ZMod (n i)),
        ∃ z ∈ AddSubgroup.closure (Set.range g),
          (Submodule.Quotient.mk z : A ⧸ (U • (⊤ : Submodule R A)))
            = e.symm x := by
      intro x
      induction x using DirectSum.induction_on with
      | zero => exact ⟨0, AddSubgroup.zero_mem _, by rw [map_zero]; simp⟩
      | of i c =>
        haveI : NeZero (n i) := ⟨by have := hn1 i; omega⟩
        have hmem : a i ∈ Set.range g := ⟨Sum.inl i, by simp [hg]⟩
        refine ⟨c.val • a i, nsmul_mem
          (AddSubgroup.subset_closure hmem) _, ?_⟩
        have hc : c.val • (1 : ZMod (n i)) = c := by
          rw [nsmul_eq_mul, mul_one, ZMod.natCast_val, ZMod.cast_id]
        calc (Submodule.Quotient.mk (c.val • a i) :
              A ⧸ (U • (⊤ : Submodule R A)))
            = c.val • (Submodule.Quotient.mk (a i) :
                A ⧸ (U • (⊤ : Submodule R A))) := by
              simp only [← Submodule.mkQ_apply, map_nsmul]
          _ = c.val • e.symm (DirectSum.of (fun i => ZMod (n i)) i 1) := by
              simp only [ha]
              rw [hlift]
          _ = e.symm (DirectSum.of (fun i => ZMod (n i)) i
                (c.val • (1 : ZMod (n i)))) := by rw [map_nsmul, map_nsmul]
          _ = e.symm (DirectSum.of (fun i => ZMod (n i)) i c) := by rw [hc]
      | add x₁ x₂ ih₁ ih₂ =>
        obtain ⟨z₁, hz₁, he₁⟩ := ih₁
        obtain ⟨z₂, hz₂, he₂⟩ := ih₂
        refine ⟨z₁ + z₂, AddSubgroup.add_mem _ hz₁ hz₂, ?_⟩
        have hmk : (Submodule.Quotient.mk (z₁ + z₂) :
            A ⧸ (U • (⊤ : Submodule R A)))
            = Submodule.Quotient.mk z₁ + Submodule.Quotient.mk z₂ := by
          simp only [← Submodule.mkQ_apply, map_add]
        rw [hmk, he₁, he₂, map_add]
    obtain ⟨z, hz, hmk⟩ := hlift' (e (Submodule.Quotient.mk y))
    rw [AddEquiv.symm_apply_apply] at hmk
    have hyz : y - z ∈ U • (⊤ : Submodule R A) :=
      (Submodule.Quotient.eq _).mp hmk.symm
    have hyz' : y - z ∈ AddSubgroup.closure (Set.range g) := by
      have hsub : (sb : Set A) ⊆ Set.range g := fun x hx =>
        ⟨Sum.inr ⟨x, hx⟩, by simp [hg]⟩
      refine AddSubgroup.closure_mono hsub ?_
      rw [hsb]
      exact hyz
    have : y = z + (y - z) := by abel
    rw [this]
    exact AddSubgroup.add_mem _ hz hyz'
  -- the relation matrix and the determinant
  have hex : ∀ i, ∃ s : κ ⊕ {x // x ∈ sb} → R,
      (∀ j, s j ∈ U) ∧ (μ i : R) • g i = ∑ j, s j • g j :=
    fun i => exists_ideal_coeffs_of_mem_smul_top hgen (hμg i)
  choose Smat hSU hSrel using hex
  have hBrel : ∀ i, ∑ j,
      (Matrix.diagonal (fun i => (μ i : R)) - Matrix.of Smat) i j • g j
        = 0 := by
    intro i
    have hdiag : ∑ j, Matrix.diagonal (fun i => (μ i : R)) i j • g j
        = (μ i : R) • g i := by
      rw [Finset.sum_eq_single i
        (fun j _ hne => by
          rw [Matrix.diagonal_apply_ne _ (Ne.symm hne), zero_smul])
        (fun h => absurd (Finset.mem_univ i) h), Matrix.diagonal_apply_eq]
    calc ∑ j, (Matrix.diagonal (fun i => (μ i : R)) - Matrix.of Smat) i j • g j
        = ∑ j, (Matrix.diagonal (fun i => (μ i : R)) i j • g j
            - Matrix.of Smat i j • g j) := by
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [Matrix.sub_apply, sub_smul]
      _ = (μ i : R) • g i - ∑ j, Smat i j • g j := by
          rw [Finset.sum_sub_distrib, hdiag]; rfl
      _ = 0 := by rw [← hSrel i, sub_self]
  refine ⟨(Matrix.diagonal (fun i => (μ i : R)) - Matrix.of Smat).det, ?_, ?_⟩
  · -- the determinant annihilates `A`
    intro x
    have hxg := det_smul_eq_zero_of_forall_sum_smul_eq_zero _ g hBrel
    have hx : x ∈ AddSubgroup.closure (Set.range g) := by
      rw [hgen]; exact AddSubgroup.mem_top x
    refine AddSubgroup.closure_induction (fun b hb => ?_) (smul_zero _)
      (fun z w _ _ hz hw => by rw [smul_add, hz, hw, add_zero])
      (fun z _ hz => by rw [smul_neg, hz, neg_zero]) hx
    obtain ⟨i, rfl⟩ := hb
    exact hxg i
  · -- the determinant is congruent to `m·1` modulo `U`
    have hdetdiag : (Matrix.diagonal (fun i => (μ i : R))).det
        = (Nat.card (A ⧸ (U • (⊤ : Submodule R A))) : R) := by
      rw [Matrix.det_diagonal, ← Nat.cast_prod, hcard, hμ,
        Fintype.prod_sum_type]
      simp
    have hmem := sub_det_diagonal_mem_of_forall_mem
      (Matrix.diagonal fun i => (μ i : R)) (Matrix.of Smat)
      (fun i j => hSU i j)
    rwa [hdetdiag] at hmem

end FiniteIndexAnnihilator

end OddOrder.Algebra
