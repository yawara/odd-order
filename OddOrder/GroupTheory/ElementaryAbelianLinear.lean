import Mathlib.Algebra.Module.ZMod
import Mathlib.Algebra.Module.Equiv.Basic
import Mathlib.LinearAlgebra.GeneralLinearGroup.Basic

/-!
# An elementary abelian `p`-group is a vector space, and its automorphisms are linear

For a commutative group `E` of exponent dividing `n`, `Additive E` carries a
`ZMod n`-module structure (`AddCommGroup.zmodModule`), and — because every additive map
between `ZMod n`-modules is automatically `ZMod n`-linear (`ZMod.map_smul`) — the
automorphism group of `E` *is* the linear group:

`MulAut E ≃* (Additive E ≃ₗ[ZMod n] Additive E)`.

For `n = 2` this identifies `Aut(E)` of an elementary abelian `2`-group with `GL(E)` over
`𝔽₂`, which is what Isaacs Problem 8C.6 is about.

The module structure is taken as an instance *argument* rather than derived inside each
statement: `AddCommGroup.zmodModule` is a `reducible non-instance`, so a caller supplies it
with `letI := AddCommGroup.zmodModule h` and then everything below applies.
`zmodModule_of_pow_eq_one` packages the exponent hypothesis into the shape it wants.

## Main results

* `OddOrder.GroupTheory.zmodModule_of_pow_eq_one` — the module structure from `x ^ n = 1`.
* `OddOrder.GroupTheory.mulAutEquivLinearEquiv` — `MulAut E ≃* (Additive E ≃ₗ[ZMod n] _)`,
  with `mulAutEquivLinearEquiv_apply` for the forward direction.
-/

set_option autoImplicit false

namespace OddOrder.GroupTheory

variable {n : ℕ} {E : Type*} [CommGroup E]

/-- **A commutative group of exponent dividing `n` is a `ZMod n`-module.**

`AddCommGroup.zmodModule` in multiplicative notation; the `n`-torsion hypothesis is the
exponent condition read through `Additive`. -/
abbrev zmodModule_of_pow_eq_one (h : ∀ x : E, x ^ n = 1) : Module (ZMod n) (Additive E) :=
  AddCommGroup.zmodModule (n := n) (G := Additive E) fun x => by
    have hx : (Additive.toMul x) ^ n = 1 := h _
    have hax := congrArg Additive.ofMul hx
    rw [ofMul_pow] at hax
    exact hax

variable [Module (ZMod n) (Additive E)]

/-- **The automorphisms of a `ZMod n`-module group are exactly its linear automorphisms.**

Every additive map between `ZMod n`-modules is `ZMod n`-linear (`ZMod.map_smul`), because
the scalars are generated by `1`; so passing to `Additive` loses nothing. -/
def mulAutEquivLinearEquiv : MulAut E ≃* (Additive E ≃ₗ[ZMod n] Additive E) where
  toFun φ :=
    { MulEquiv.toAdditive φ with
      map_smul' := fun c x => ZMod.map_smul (MulEquiv.toAdditive φ) c x }
  invFun ψ := MulEquiv.toAdditive.symm ψ.toAddEquiv
  left_inv _ := by ext; rfl
  right_inv _ := by ext; rfl
  map_mul' _ _ := by ext; rfl

@[simp]
theorem mulAutEquivLinearEquiv_apply (φ : MulAut E) (x : E) :
    (mulAutEquivLinearEquiv (n := n) φ) (Additive.ofMul x) = Additive.ofMul (φ x) := rfl

/-- **群作用から `ZMod n`-線形表現へ.** `A` が可換で指数が `n` を割るとき, 作用
`φ : G →* MulAut A` は `Additive A` 上の `ZMod n`-線形表現を定める
(`mulAutEquivLinearEquiv` で線形同型に移し, 単元群から `End` へ落とす).

Maschke (`MonoidAlgebra.Submodule.exists_isCompl`) を当てるための入口. -/
noncomputable def linearOfMulAutHom {G : Type*} [Group G] (φ : G →* MulAut E) :
    G →* (Additive E) →ₗ[ZMod n] (Additive E) :=
  (Units.coeHom (Module.End (ZMod n) (Additive E))).comp
    (((LinearMap.GeneralLinearGroup.generalLinearEquiv (ZMod n)
        (Additive E)).symm.toMonoidHom).comp
      ((mulAutEquivLinearEquiv (n := n) (E := E)).toMonoidHom.comp φ))

@[simp]
theorem linearOfMulAutHom_apply {G : Type*} [Group G] (φ : G →* MulAut E) (g : G) (x : E) :
    linearOfMulAutHom (n := n) φ g (Additive.ofMul x) = Additive.ofMul (φ g x) := rfl

end OddOrder.GroupTheory
