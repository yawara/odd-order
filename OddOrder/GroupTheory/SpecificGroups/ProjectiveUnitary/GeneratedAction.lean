import OddOrder.GroupTheory.SpecificGroups.ProjectiveUnitary.StandardGenerators
import Mathlib.GroupTheory.GroupAction.MultipleTransitivity

/-!
# The permutation group generated by the standard `PSU(3,q)` transformations

This file packages the root, determinant-one torus, and Weyl permutations as
a concrete subgroup of the full permutation group of the Hermitian unital.
In particular, the torus generators are indexed by `PSUTorusParameter`, not by
the larger projective-unitary diagonal parameter group.

The root translations are regular on the affine chart and the Weyl involution
interchanges infinity with the affine origin. From these concrete formulas the
standard generated action is proved doubly transitive.

This supplies the unitary target for **Peterfalvi, Part II, Chapter I §3,
Lemma 1** (p. 105). The coordinate transformations themselves are recorded in
Part II, Chapters III §3 and IV §3.
-/

set_option autoImplicit false

namespace OddOrder.GroupTheory.SpecificGroups.ProjectiveUnitary

section /- Part II, Chapter I §3, Lemma 1: the standard unitary action -/

namespace Unital

/-- The affine origin of the Hermitian unital. -/
noncomputable def origin (n : ℕ) : Unital n := affine (1 : RootGroup n)

@[simp] theorem origin_eq_affine_one (n : ℕ) :
    origin n = affine (1 : RootGroup n) := rfl

end Unital

/-- The determinant-one torus action on the Hermitian root group. -/
noncomputable def psuTorusScaleHom (n : ℕ) :
    PSUTorusParameter n →* MulAut (RootGroup n) :=
  (torusScaleHom n).comp (PSUTorusParameter n).subtype

@[simp]
theorem psuTorusScaleHom_apply {n : ℕ}
    (c : PSUTorusParameter n) (u : RootGroup n) :
    psuTorusScaleHom n c u = scalePoint c.1 u := rfl

/-- The standard root, determinant-one torus, and Weyl generating set. -/
noncomputable def standardGeneratorSet (n : ℕ) : Set (Equiv.Perm (Unital n)) :=
  Set.range (Unital.rootPermHom n) ∪
    (Set.range (Unital.psuTorusPerm n) ∪ {Unital.weylPerm n})

/-- The concrete permutation group generated by the standard unitary
transformations. -/
noncomputable def standardPermGroup (n : ℕ) : Subgroup (Equiv.Perm (Unital n)) :=
  Subgroup.closure (standardGeneratorSet n)

/-- Every root translation belongs to the standard generated group. -/
theorem rootPerm_mem_standardPermGroup {n : ℕ} (u : RootGroup n) :
    Unital.rootPermHom n u ∈ standardPermGroup n := by
  apply Subgroup.subset_closure
  exact Or.inl ⟨u, rfl⟩

/-- Every determinant-one torus scaling belongs to the standard generated group. -/
theorem psuTorusPerm_mem_standardPermGroup {n : ℕ} (c : PSUTorusParameter n) :
    Unital.psuTorusPerm n c ∈ standardPermGroup n := by
  apply Subgroup.subset_closure
  exact Or.inr (Or.inl ⟨c, rfl⟩)

/-- The Weyl involution belongs to the standard generated group. -/
theorem weylPerm_mem_standardPermGroup (n : ℕ) :
    Unital.weylPerm n ∈ standardPermGroup n := by
  apply Subgroup.subset_closure
  exact Or.inr (Or.inr rfl)

/-- The standard generated group is contained in every subgroup containing
all root, determinant-one torus, and Weyl generators. -/
theorem standardPermGroup_le {n : ℕ} {H : Subgroup (Equiv.Perm (Unital n))}
    (hroot : ∀ u : RootGroup n, Unital.rootPermHom n u ∈ H)
    (htorus : ∀ c : PSUTorusParameter n, Unital.psuTorusPerm n c ∈ H)
    (hweyl : Unital.weylPerm n ∈ H) :
    standardPermGroup n ≤ H := by
  rw [standardPermGroup, Subgroup.closure_le]
  intro g hg
  rcases hg with hrootMem | hrest
  · obtain ⟨u, rfl⟩ := hrootMem
    exact hroot u
  · rcases hrest with htorusMem | hweylMem
    · obtain ⟨c, rfl⟩ := htorusMem
      exact htorus c
    · have hgw : g = Unital.weylPerm n := by
        simpa only [Set.mem_singleton_iff] using hweylMem
      rw [hgw]
      exact hweyl

/-- Root translations regarded as elements of the standard generated group. -/
noncomputable def rootHom (n : ℕ) : RootGroup n →* standardPermGroup n :=
  (Unital.rootPermHom n).codRestrict (standardPermGroup n)
    rootPerm_mem_standardPermGroup

/-- Determinant-one torus scalings regarded as elements of the standard
generated group. -/
noncomputable def psuTorusHom (n : ℕ) :
    PSUTorusParameter n →* standardPermGroup n :=
  (Unital.psuTorusPerm n).codRestrict (standardPermGroup n)
    psuTorusPerm_mem_standardPermGroup

/-- The Weyl involution regarded as an element of the standard generated group. -/
noncomputable def weylElement (n : ℕ) : standardPermGroup n :=
  ⟨Unital.weylPerm n, weylPerm_mem_standardPermGroup n⟩

@[simp] theorem coe_rootHom {n : ℕ} (u : RootGroup n) :
    ((rootHom n u : standardPermGroup n) : Equiv.Perm (Unital n)) =
      Unital.rootPermHom n u :=
  rfl

@[simp] theorem coe_psuTorusHom {n : ℕ} (c : PSUTorusParameter n) :
    ((psuTorusHom n c : standardPermGroup n) : Equiv.Perm (Unital n)) =
      Unital.psuTorusPerm n c :=
  rfl

@[simp] theorem coe_weylElement (n : ℕ) :
    ((weylElement n : standardPermGroup n) : Equiv.Perm (Unital n)) =
      Unital.weylPerm n :=
  rfl

/-- The lifted root representation remains faithful. -/
theorem rootHom_injective (n : ℕ) : Function.Injective (rootHom n) := by
  intro u v huv
  apply Unital.rootPermHom_injective n
  exact congrArg Subtype.val huv

/-- The lifted determinant-one torus representation remains faithful. -/
theorem psuTorusHom_injective (n : ℕ) : Function.Injective (psuTorusHom n) := by
  intro c d hcd
  apply Unital.psuTorusPerm_injective n
  exact congrArg Subtype.val hcd

@[simp] theorem rootHom_smul_infinity {n : ℕ} (u : RootGroup n) :
    rootHom n u • Unital.infinity n = Unital.infinity n :=
  Unital.rootPerm_infinity u

@[simp] theorem rootHom_smul_affine {n : ℕ} (u v : RootGroup n) :
    rootHom n u • Unital.affine v = Unital.affine (u * v) :=
  Unital.rootPerm_affine u v

@[simp] theorem psuTorusHom_smul_infinity {n : ℕ} (c : PSUTorusParameter n) :
    psuTorusHom n c • Unital.infinity n = Unital.infinity n :=
  Unital.torusPerm_infinity c.1

@[simp] theorem psuTorusHom_smul_affine {n : ℕ}
    (c : PSUTorusParameter n) (u : RootGroup n) :
    psuTorusHom n c • Unital.affine u =
      Unital.affine (psuTorusScaleHom n c u) :=
  Unital.torusPerm_affine c.1 u

@[simp] theorem weylElement_smul_infinity (n : ℕ) :
    weylElement n • Unital.infinity n = Unital.origin n :=
  Unital.weylPerm_infinity n

@[simp] theorem weylElement_smul_origin (n : ℕ) :
    weylElement n • Unital.origin n = Unital.infinity n :=
  Unital.weylPerm_origin n

theorem weylElement_smul_affine_of_ne_one {n : ℕ}
    (u : RootGroup n) (hu : u ≠ 1) :
    weylElement n • Unital.affine u =
      Unital.affine (RootGroup.weylReciprocal u hu) :=
  Unital.weylPerm_affine_of_ne_one u hu

theorem weylElement_smul_affine_of_snd_ne_zero {n : ℕ}
    (u : RootGroup n) (hu : u.snd ≠ 0) :
    weylElement n • Unital.affine u =
      Unital.affine
        (RootGroup.weylReciprocal u ((RootGroup.ne_one_iff_snd_ne_zero u).mpr hu)) :=
  Unital.weylPerm_affine_of_snd_ne_zero u hu

/-- The Weyl generator is an involution inside the generated subgroup. -/
theorem weylElement_sq_eq_one (n : ℕ) : weylElement n ^ 2 = 1 := by
  apply Subtype.ext
  apply Equiv.Perm.ext
  intro p
  change Unital.weylPerm n (Unital.weylPerm n p) = p
  exact Unital.weylPerm_apply_self n p

/-- Determinant-one torus conjugation carries a root translation to the
scaled translation inside the generated subgroup. -/
theorem psuTorusHom_mul_rootHom_mul_inv {n : ℕ}
    (c : PSUTorusParameter n) (u : RootGroup n) :
    psuTorusHom n c * rootHom n u * (psuTorusHom n c)⁻¹ =
      rootHom n (psuTorusScaleHom n c u) := by
  apply Subtype.ext
  exact Unital.torusPerm_mul_rootPerm_mul_inv c.1 u

/-- Weyl conjugation preserves the determinant-one torus inside the generated
subgroup. -/
theorem weylElement_mul_psuTorusHom_mul_weylElement {n : ℕ}
    (c : PSUTorusParameter n) :
    weylElement n * psuTorusHom n c * weylElement n =
      psuTorusHom n (Unital.psuWeylParameterHom n c) := by
  apply Subtype.ext
  exact Unital.weylPerm_mul_psuTorusPerm_mul_weylPerm c

open MulAction

/-- Every unital point can be carried to infinity by an element of the
standard generated group. -/
theorem standardPermGroup_exists_smul_eq_infinity (n : ℕ) (p : Unital n) :
    ∃ g : standardPermGroup n, g • p = Unital.infinity n := by
  cases p with
  | none => exact ⟨1, one_smul _ _⟩
  | some u =>
      refine ⟨weylElement n * rootHom n u⁻¹, ?_⟩
      change Unital.weylPerm n (Unital.affine (u⁻¹ * u)) = Unital.infinity n
      rw [inv_mul_cancel]
      exact Unital.weylPerm_origin n

/-- The standard generated group is transitive on the Hermitian unital. -/
theorem standardPermGroup_isPretransitive (n : ℕ) :
    IsPretransitive (standardPermGroup n) (Unital n) where
  exists_smul_eq a b := by
    obtain ⟨ga, hga⟩ := standardPermGroup_exists_smul_eq_infinity n a
    obtain ⟨gb, hgb⟩ := standardPermGroup_exists_smul_eq_infinity n b
    refine ⟨gb⁻¹ * ga, ?_⟩
    rw [mul_smul, hga, inv_smul_eq_iff, hgb]

/-- The stabilizer of infinity is transitive on the affine chart.  Root
translations already act regularly there. -/
theorem standardPermGroup_infinityStabilizer_isPretransitive (n : ℕ) :
    IsPretransitive (stabilizer (standardPermGroup n) (Unital.infinity n))
      (SubMulAction.ofStabilizer (standardPermGroup n) (Unital.infinity n)) where
  exists_smul_eq x y := by
    rcases x with ⟨p, hp⟩
    rcases y with ⟨q, hq⟩
    cases p with
    | none => exact (hp rfl).elim
    | some u =>
      cases q with
      | none => exact (hq rfl).elim
      | some v =>
        let r : standardPermGroup n := rootHom n (v * u⁻¹)
        have hr : r ∈ stabilizer (standardPermGroup n) (Unital.infinity n) := by
          rw [mem_stabilizer_iff]
          change Unital.rootPermHom n (v * u⁻¹) (Unital.infinity n) =
            Unital.infinity n
          exact Unital.rootPerm_infinity _
        refine ⟨⟨r, hr⟩, ?_⟩
        apply Subtype.ext
        change Unital.affine ((v * u⁻¹) * u) = Unital.affine v
        rw [mul_assoc, inv_mul_cancel, mul_one]

/-- **Peterfalvi Part II, Chapter I §3, Lemma 1.** The standard action of the
generated unitary permutation group is doubly transitive. -/
theorem standardPermGroup_isMultiplyPretransitive (n : ℕ) :
    IsMultiplyPretransitive (standardPermGroup n) (Unital n) 2 := by
  letI : IsPretransitive (standardPermGroup n) (Unital n) :=
    standardPermGroup_isPretransitive n
  rw [show (2 : ℕ) = Nat.succ 1 by rfl,
    SubMulAction.ofStabilizer.isMultiplyPretransitive (a := Unital.infinity n),
    MulAction.is_one_pretransitive_iff]
  exact standardPermGroup_infinityStabilizer_isPretransitive n

end

end OddOrder.GroupTheory.SpecificGroups.ProjectiveUnitary
