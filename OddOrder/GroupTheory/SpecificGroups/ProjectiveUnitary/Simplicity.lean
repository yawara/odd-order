import Mathlib.GroupTheory.FixedPointFree
import Mathlib.GroupTheory.Nilpotent
import OddOrder.GroupTheory.GroupAction.PerfectQuasiprimitive
import OddOrder.GroupTheory.SpecificGroups.ProjectiveUnitary.Bruhat

/-!
# Simplicity of the standard projective unitary group

For `q = 2 ^ n > 2`, this file proves that the concrete permutation group
generated by the standard root, determinant-one torus, and Weyl
transformations is simple.  The proof shows that the group is perfect, that
its doubly transitive action is primitive, and that its point stabilizer is
solvable.

This supplies the `PSU(3,q)` simplicity input used in **Peterfalvi, Part II,
Chapter I §3, Lemma 1** (pp. 100--107).  Peterfalvi cites Huppert,
Kapitel II, Satz 10.13 for this fact rather than proving it.  The hypothesis
`1 < n` is the exact translation of Peterfalvi's `q > 2`; the case `n = 1`
has group order `72` and is not simple.
-/

set_option autoImplicit false

namespace OddOrder.GroupTheory.SpecificGroups.ProjectiveUnitary

open scoped commutatorElement

noncomputable section

variable {n : ℕ}

section /- Part II, Ch. I §3 Lemma 1: perfectness -/

/-- **Peterfalvi Part II, Ch. I §3 Lemma 1 (unitary target).**
A determinant-one torus scaling whose Hermitian norm weight is
nontrivial acts fixed-point-freely on the root group. -/
theorem psuTorusScale_fixedPointFree_of_torusWeight_ne_one
    (c : PSUTorusParameter n) (hc : torusWeight c.1 ≠ 1) :
    MonoidHom.FixedPointFree (psuTorusScaleHom n c) := by
  intro u hu
  apply (RootGroup.eq_one_iff_snd_eq_zero u).2
  have hsnd := congrArg RootGroup.snd hu
  simp only [psuTorusScaleHom_apply, scalePoint_snd] at hsnd
  by_contra hb
  apply hc
  apply mul_right_cancel₀ hb
  simpa only [one_mul] using hsnd

/-- **Peterfalvi Part II, Ch. I §3 Lemma 1 (unitary target).**
For a fixed-point-free determinant-one torus scaling, the root
displacement map is surjective. -/
theorem psuTorusScale_mul_inv_surjective
    (c : PSUTorusParameter n) (hc : torusWeight c.1 ≠ 1) :
    Function.Surjective
      (fun v : RootGroup n ↦ psuTorusScaleHom n c v * v⁻¹) := by
  intro u
  obtain ⟨v, hv⟩ :=
    (psuTorusScale_fixedPointFree_of_torusWeight_ne_one c hc).commutatorMap_surjective u⁻¹
  refine ⟨v, ?_⟩
  simpa only [MonoidHom.commutatorMap_apply, div_eq_mul_inv, mul_inv_rev,
    inv_inv] using congrArg Inv.inv hv

/-- **Peterfalvi Part II, Ch. I §3 Lemma 1 (unitary target).**
The torus--root commutator is the corresponding root displacement. -/
theorem commutator_psuTorusHom_rootHom
    (c : PSUTorusParameter n) (u : RootGroup n) :
    ⁅psuTorusHom n c, rootHom n u⁆ =
      rootHom n (psuTorusScaleHom n c u * u⁻¹) := by
  rw [commutatorElement_def, psuTorusHom_mul_rootHom_mul_inv,
    ← map_inv, ← map_mul]

/-- For `q = 2^n > 2`, the determinant-one torus contains an element whose
Hermitian norm weight is nontrivial. -/
private theorem exists_psuTorus_weight_ne_one (hn : 1 < n) :
    ∃ c : PSUTorusParameter n, torusWeight c.1 ≠ 1 := by
  have hn0 : 0 < n := by omega
  have hUnits : 1 < Nat.card ((BaseField n)ˣ) := by
    rw [Nat.card_units, natCard_baseField n hn0]
    have hfour : 4 ≤ 2 ^ n := by
      have := Nat.pow_le_pow_right (n := 2) (by omega) (by omega : 2 ≤ n)
      norm_num at this ⊢
      exact this
    omega
  letI : Nontrivial ((BaseField n)ˣ) :=
    Finite.one_lt_card_iff_nontrivial.mp hUnits
  obtain ⟨d, hd⟩ : ∃ d : (BaseField n)ˣ, d ≠ 1 := exists_ne 1
  let b : Field n := algebraMap (BaseField n) (Field n) (d : BaseField n)
  have hb0 : b ≠ 0 := by
    exact (map_ne_zero (algebraMap (BaseField n) (Field n))).2 (Units.ne_zero d)
  have hb1 : b ≠ 1 := by
    intro h
    apply hd
    apply Units.ext
    change (d : BaseField n) = 1
    apply (algebraMap (BaseField n) (Field n)).injective
    simpa only [b, map_one] using h
  have hbsq : b * b ≠ 1 := by
    rw [← pow_two, sq_ne_one_iff]
    exact ⟨hb1, by simpa only [CharTwo.neg_eq] using hb1⟩
  let u : RootGroup n :=
    ⟨0, b, by
      simp only [b, star_algebraMap, CharTwo.add_self_eq_zero,
        zero_mul, star_zero]⟩
  have hu : u ≠ 1 := by
    intro h
    apply hb0
    have hsnd := congrArg RootGroup.snd h
    simpa only [u, RootGroup.snd_one] using hsnd
  refine ⟨bruhatTorus u hu hn0, ?_⟩
  rw [torusWeight_bruhatTorus]
  have hbstar : star b = b := by
    exact star_algebraMap n (d : BaseField n)
  rw [hbstar]
  intro h
  apply hbsq
  have hinv : (b * b)⁻¹ = 1 := by
    simpa only [one_div] using h
  exact inv_eq_one.mp hinv

/-- **Peterfalvi Part II, Ch. IV §3 Prop. (4)--(5); Ch. I §3 Lemma 1.**
Every determinant-one torus parameter occurs as the Hua parameter of a
nonidentity root element. -/
theorem bruhatTorus_surjective (n : ℕ) (hn : 0 < n) :
    Function.Surjective
      (fun u : {u : RootGroup n // u ≠ 1} ↦
        bruhatTorus u.1 u.2 hn) := by
  intro c
  rcases c.2 with ⟨t, ht⟩
  have hspecial : specialTorusWeightHom n t = c.1 := by
    rw [specialTorusWeightHom_eq_powMonoidHom n hn]
    exact ht
  let b : Field n := (t : Field n)⁻¹
  have hbstar : star (b + star b) = b + star b := by
    simp only [star_add, star_star]
    exact add_comm _ _
  obtain ⟨a, ha⟩ := exists_mul_star_eq_of_star_eq n hn hbstar
  let u : RootGroup n := ⟨a, b, ha.symm⟩
  have hb0 : b ≠ 0 := inv_ne_zero (Units.ne_zero t)
  have hu : u ≠ 1 := by
    intro h
    apply hb0
    have hsnd := congrArg RootGroup.snd h
    simpa only [u, RootGroup.snd_one] using hsnd
  refine ⟨⟨u, hu⟩, ?_⟩
  change bruhatTorus u hu hn = c
  apply Subtype.ext
  change bruhatFullTorus u hu = c.1
  rw [bruhatFullTorus_eq_specialTorusWeight]
  rw [show bruhatSourceUnit u hu = t by
    apply Units.ext
    simp only [coe_bruhatSourceUnit, u, b, inv_inv]]
  exact hspecial

/-- **Peterfalvi Part II, Ch. I §3 Lemma 1 (unitary target).**
For `q = 2^n > 2`, every standard root generator belongs to the derived
subgroup. -/
theorem rootHom_mem_commutator (hn : 1 < n) (u : RootGroup n) :
    rootHom n u ∈ commutator (standardPermGroup n) := by
  obtain ⟨c, hc⟩ := exists_psuTorus_weight_ne_one hn
  obtain ⟨v, hv⟩ := psuTorusScale_mul_inv_surjective c hc u
  rw [← hv, ← commutator_psuTorusHom_rootHom]
  exact Subgroup.commutator_mem_commutator
    (Subgroup.mem_top _) (Subgroup.mem_top _)

/-- **Peterfalvi Part II, Ch. I §3 Lemma 1; Ch. IV §3 Prop. (4)--(5).**
For `q = 2^n > 2`, the standard Weyl involution belongs to the derived
subgroup. -/
theorem weylElement_mem_commutator (hn : 1 < n) :
    weylElement n ∈ commutator (standardPermGroup n) := by
  have hn0 : 0 < n := by omega
  let u : RootGroup n := ⟨0, 1, by
    simpa only [star_one, zero_mul] using
      (CharTwo.add_self_eq_zero (1 : Field n))⟩
  have hu : u ≠ 1 := by
    apply (RootGroup.ne_one_iff_snd_ne_zero u).2
    simp only [u]
    exact one_ne_zero
  have htorus : bruhatTorus u hu hn0 = 1 := by
    apply Subtype.ext
    apply Units.ext
    change (1 : Field n) / star (1 : Field n) ^ 2 = 1
    simp
  have hwinv : (weylElement n)⁻¹ = weylElement n := by
    apply inv_eq_iff_mul_eq_one.mpr
    simpa only [pow_two] using weylElement_sq_eq_one n
  let C := commutator (standardPermGroup n)
  have hroot (v : RootGroup n) : rootHom n v ∈ C :=
    rootHom_mem_commutator hn v
  have hleft : weylElement n * rootHom n u * weylElement n ∈ C := by
    rw [← hwinv]
    exact (inferInstance : C.Normal).conj_mem
      (rootHom n u) (hroot u) (weylElement n)
  have hrel :
      weylElement n * rootHom n u * weylElement n =
        rootHom n (RootGroup.weylReciprocal u hu) *
          psuTorusHom n (bruhatTorus u hu hn0) * weylElement n *
            rootHom n (RootGroup.reciprocal u hu) := by
    apply Subtype.ext
    exact Unital.weylPerm_mul_rootPerm_mul_weylPerm_eq_bruhat u hu hn0
  have hright :
      rootHom n (RootGroup.weylReciprocal u hu) *
          psuTorusHom n (bruhatTorus u hu hn0) * weylElement n *
            rootHom n (RootGroup.reciprocal u hu) ∈ C := by
    rw [← hrel]
    exact hleft
  rw [htorus, map_one, mul_one] at hright
  have hprefix : rootHom n (RootGroup.weylReciprocal u hu) ∈ C :=
    hroot _
  have hisolate := C.mul_mem
    (C.mul_mem (C.inv_mem hprefix) hright)
    (C.inv_mem (hroot (RootGroup.reciprocal u hu)))
  convert hisolate using 1; group

/-- **Peterfalvi Part II, Ch. I §3 Lemma 1; Ch. IV §3 Prop. (4)--(5).**
For `q = 2^n > 2`, every determinant-one torus generator belongs to the
derived subgroup. -/
theorem psuTorusHom_mem_commutator
    (hn : 1 < n) (c : PSUTorusParameter n) :
    psuTorusHom n c ∈ commutator (standardPermGroup n) := by
  have hn0 : 0 < n := by omega
  obtain ⟨⟨u, hu⟩, huc⟩ := bruhatTorus_surjective n hn0 c
  let C := commutator (standardPermGroup n)
  have hroot (v : RootGroup n) : rootHom n v ∈ C :=
    rootHom_mem_commutator hn v
  have hw : weylElement n ∈ C := weylElement_mem_commutator hn
  have hwinv : (weylElement n)⁻¹ = weylElement n := by
    apply inv_eq_iff_mul_eq_one.mpr
    simpa only [pow_two] using weylElement_sq_eq_one n
  have hleft : weylElement n * rootHom n u * weylElement n ∈ C := by
    rw [← hwinv]
    exact (inferInstance : C.Normal).conj_mem
      (rootHom n u) (hroot u) (weylElement n)
  have hrel :
      weylElement n * rootHom n u * weylElement n =
        rootHom n (RootGroup.weylReciprocal u hu) *
          psuTorusHom n (bruhatTorus u hu hn0) * weylElement n *
            rootHom n (RootGroup.reciprocal u hu) := by
    apply Subtype.ext
    exact Unital.weylPerm_mul_rootPerm_mul_weylPerm_eq_bruhat u hu hn0
  have hright :
      rootHom n (RootGroup.weylReciprocal u hu) *
          psuTorusHom n c * weylElement n *
            rootHom n (RootGroup.reciprocal u hu) ∈ C := by
    rw [← huc, ← hrel]
    exact hleft
  have hisolate := C.mul_mem
    (C.mul_mem
      (C.mul_mem (C.inv_mem (hroot (RootGroup.weylReciprocal u hu)))
        hright)
      (C.inv_mem (hroot (RootGroup.reciprocal u hu))))
    (C.inv_mem hw)
  convert hisolate using 1; group

/-- **Peterfalvi Part II, Ch. I §3 Lemma 1 (unitary target).**
For `q = 2^n > 2`, the standard projective unitary permutation group is
perfect. -/
theorem commutator_standardPermGroup_eq_top (hn : 1 < n) :
    commutator (standardPermGroup n) = ⊤ := by
  let C := commutator (standardPermGroup n)
  let H : Subgroup (Equiv.Perm (Unital n)) :=
    C.map (standardPermGroup n).subtype
  have hle : standardPermGroup n ≤ H := by
    apply standardPermGroup_le
    · intro u
      change ((rootHom n u : standardPermGroup n) :
        Equiv.Perm (Unital n)) ∈ H
      exact Subgroup.mem_map_of_mem (standardPermGroup n).subtype
        (rootHom_mem_commutator hn u)
    · intro c
      change ((psuTorusHom n c : standardPermGroup n) :
        Equiv.Perm (Unital n)) ∈ H
      exact Subgroup.mem_map_of_mem (standardPermGroup n).subtype
        (psuTorusHom_mem_commutator hn c)
    · change ((weylElement n : standardPermGroup n) :
        Equiv.Perm (Unital n)) ∈ H
      exact Subgroup.mem_map_of_mem (standardPermGroup n).subtype
        (weylElement_mem_commutator hn)
  apply top_unique
  intro g _
  have hg : (g : Equiv.Perm (Unital n)) ∈ H := hle g.property
  rcases hg with ⟨x, hx, hxeq⟩
  have hxg : x = g := Subtype.ext hxeq
  exact hxg ▸ hx

end

section /- Part II, Ch. I §3 Lemma 1: solvable stabilizer -/

/-- The Hermitian root group is solvable because it is a finite `2`-group. -/
private theorem rootGroup_isSolvable (n : ℕ) (hn : 0 < n) :
    IsSolvable (RootGroup n) := by
  letI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  letI : Group.IsNilpotent (RootGroup n) :=
    IsPGroup.isNilpotent (p := 2) (RootGroup.isPGroup n hn)
  infer_instance

/-- The root--determinant-one-torus semidirect-product model is solvable. -/
private theorem borelModel_isSolvable (n : ℕ) (hn : 0 < n) :
    IsSolvable (BorelModel n) := by
  letI : IsSolvable (RootGroup n) := rootGroup_isSolvable n hn
  exact solvable_of_ker_le_range
    (SemidirectProduct.inl : RootGroup n →* BorelModel n)
    (SemidirectProduct.rightHom : BorelModel n →* PSUTorusParameter n)
    (by rw [← SemidirectProduct.range_inl_eq_ker_rightHom])

/-- **Peterfalvi Part II, Ch. I §3 Lemma 1 (unitary target).**
The standard determinant-one Borel subgroup is solvable. -/
theorem standardBorel_isSolvable (n : ℕ) (hn : 0 < n) :
    IsSolvable (standardBorel n) := by
  letI : IsSolvable (BorelModel n) := borelModel_isSolvable n hn
  change IsSolvable (borelHom n).range
  exact solvable_of_surjective (borelHom n).rangeRestrict_surjective

end


section /- Part II, Ch. I §3 Lemma 1: simplicity -/

private lemma standardPermGroup_nontrivial (n : ℕ) :
    Nontrivial (standardPermGroup n) := by
  refine ⟨⟨weylElement n, 1, ?_⟩⟩
  intro h
  have hp := congrArg
    (fun g : standardPermGroup n ↦ g • Unital.infinity n) h
  rw [weylElement_smul_infinity, one_smul] at hp
  change (some (1 : RootGroup n) : Option (RootGroup n)) = none at hp
  exact Option.some_ne_none _ hp

/-- **Peterfalvi Part II, Ch. I §3 Lemma 1 (unitary target).**
For `q = 2^n > 2`, the concrete standard projective unitary permutation group
is simple. -/
theorem standardPermGroup_isSimpleGroup (hn : 1 < n) :
    IsSimpleGroup (standardPermGroup n) := by
  have hn0 : 0 < n := by omega
  letI : Nontrivial (standardPermGroup n) :=
    standardPermGroup_nontrivial n
  letI : MulAction.IsPreprimitive (standardPermGroup n) (Unital n) :=
    MulAction.isPreprimitive_of_is_two_pretransitive
      (standardPermGroup_isMultiplyPretransitive n)
  letI : Group.IsPerfect (standardPermGroup n) :=
    ⟨commutator_standardPermGroup_eq_top hn⟩
  letI : IsSolvable
      (MulAction.stabilizer (standardPermGroup n) (Unital.infinity n)) := by
    rw [← standardBorel_eq_infinityStabilizer n hn0]
    exact standardBorel_isSolvable n hn0
  exact isSimpleGroup_of_isPerfect_of_isQuasiPreprimitive_of_isSolvable_stabilizer
    (Unital.infinity n)

end


