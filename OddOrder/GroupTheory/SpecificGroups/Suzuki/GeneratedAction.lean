import OddOrder.GroupTheory.SpecificGroups.Suzuki.StandardGenerators
import Mathlib.GroupTheory.GroupAction.MultipleTransitivity

/-!
# The permutation group generated by the standard Suzuki transformations

This file packages the root, torus, and Weyl permutations as a concrete
subgroup of the full permutation group of the Suzuki ovoid.  It proves that
the root and Weyl elements make the standard action doubly transitive: the
root group is regular on the affine complement of infinity, while the Weyl
involution interchanges infinity and the affine origin.

This is shared infrastructure for the Suzuki target in **Peterfalvi, Part II,
Chapter I, Theorem A** (pp. 97-98).
-/

set_option autoImplicit false

namespace OddOrder.GroupTheory.SpecificGroups.Suzuki

/-- The standard root, torus, and Weyl generating set. -/
noncomputable def standardGeneratorSet (m : ℕ) : Set (Equiv.Perm (Ovoid m)) :=
  Set.range (Ovoid.rootPermHom m) ∪
    (Set.range (Ovoid.torusPerm m) ∪ {Ovoid.weylPerm m})

/-- The concrete permutation group generated by the standard Suzuki
transformations. -/
noncomputable def standardPermGroup (m : ℕ) : Subgroup (Equiv.Perm (Ovoid m)) :=
  Subgroup.closure (standardGeneratorSet m)

/-- Every root translation belongs to the standard generated group. -/
theorem rootPerm_mem_standardPermGroup {m : ℕ} (u : RootGroup m) :
    Ovoid.rootPermHom m u ∈ standardPermGroup m := by
  apply Subgroup.subset_closure
  exact Or.inl ⟨u, rfl⟩

/-- Every torus scaling belongs to the standard generated group. -/
theorem torusPerm_mem_standardPermGroup {m : ℕ} (c : TorusParameter m) :
    Ovoid.torusPerm m c ∈ standardPermGroup m := by
  apply Subgroup.subset_closure
  exact Or.inr (Or.inl ⟨c, rfl⟩)

/-- The Weyl involution belongs to the standard generated group. -/
theorem weylPerm_mem_standardPermGroup (m : ℕ) :
    Ovoid.weylPerm m ∈ standardPermGroup m := by
  apply Subgroup.subset_closure
  exact Or.inr (Or.inr rfl)

/-- The standard generated group is contained in every subgroup containing all
root, torus, and Weyl generators. -/
theorem standardPermGroup_le {m : ℕ} {H : Subgroup (Equiv.Perm (Ovoid m))}
    (hroot : ∀ u : RootGroup m, Ovoid.rootPermHom m u ∈ H)
    (htorus : ∀ c : TorusParameter m, Ovoid.torusPerm m c ∈ H)
    (hweyl : Ovoid.weylPerm m ∈ H) :
    standardPermGroup m ≤ H := by
  rw [standardPermGroup, Subgroup.closure_le]
  intro g hg
  rcases hg with hrootMem | hrest
  · obtain ⟨u, rfl⟩ := hrootMem
    exact hroot u
  · rcases hrest with htorusMem | hweylMem
    · obtain ⟨c, rfl⟩ := htorusMem
      exact htorus c
    · have hgw : g = Ovoid.weylPerm m := by
        simpa only [Set.mem_singleton_iff] using hweylMem
      rw [hgw]
      exact hweyl

/-- Root translations regarded as elements of the standard generated group. -/
noncomputable def rootHom (m : ℕ) : RootGroup m →* standardPermGroup m :=
  (Ovoid.rootPermHom m).codRestrict (standardPermGroup m)
    rootPerm_mem_standardPermGroup

/-- Torus scalings regarded as elements of the standard generated group. -/
noncomputable def torusHom (m : ℕ) : TorusParameter m →* standardPermGroup m :=
  (Ovoid.torusPerm m).codRestrict (standardPermGroup m)
    torusPerm_mem_standardPermGroup

/-- The Weyl involution regarded as an element of the standard generated group. -/
noncomputable def weylElement (m : ℕ) : standardPermGroup m :=
  ⟨Ovoid.weylPerm m, weylPerm_mem_standardPermGroup m⟩

@[simp] theorem coe_rootHom {m : ℕ} (u : RootGroup m) :
    ((rootHom m u : standardPermGroup m) : Equiv.Perm (Ovoid m)) =
      Ovoid.rootPermHom m u :=
  rfl

@[simp] theorem coe_torusHom {m : ℕ} (c : TorusParameter m) :
    ((torusHom m c : standardPermGroup m) : Equiv.Perm (Ovoid m)) =
      Ovoid.torusPerm m c :=
  rfl

@[simp] theorem coe_weylElement (m : ℕ) :
    ((weylElement m : standardPermGroup m) : Equiv.Perm (Ovoid m)) =
      Ovoid.weylPerm m :=
  rfl

/-- The lifted root representation remains faithful. -/
theorem rootHom_injective (m : ℕ) : Function.Injective (rootHom m) := by
  intro u v huv
  apply Ovoid.rootPermHom_injective m
  exact congrArg Subtype.val huv

/-- The lifted torus representation remains faithful. -/
theorem torusHom_injective (m : ℕ) : Function.Injective (torusHom m) := by
  intro c d hcd
  apply Ovoid.torusPerm_injective m
  exact congrArg Subtype.val hcd

@[simp] theorem rootHom_smul_infinity {m : ℕ} (u : RootGroup m) :
    rootHom m u • Ovoid.infinity m = Ovoid.infinity m :=
  Ovoid.rootPermHom_apply_infinity u

@[simp] theorem rootHom_smul_affine {m : ℕ} (u v : RootGroup m) :
    rootHom m u • Ovoid.affine v = Ovoid.affine (u * v) :=
  Ovoid.rootPermHom_apply_affine u v

@[simp] theorem torusHom_smul_infinity {m : ℕ} (c : TorusParameter m) :
    torusHom m c • Ovoid.infinity m = Ovoid.infinity m :=
  Ovoid.torusPerm_infinity c

@[simp] theorem torusHom_smul_affine {m : ℕ}
    (c : TorusParameter m) (u : RootGroup m) :
    torusHom m c • Ovoid.affine u = Ovoid.affine (torusScale c u) :=
  Ovoid.torusPerm_affine c u

@[simp] theorem torusHom_smul_affineMk {m : ℕ}
    (c : TorusParameter m) (x y : Field m) :
    torusHom m c • Ovoid.affineMk x y =
      Ovoid.affineMk (x / (c : Field m)) (y / torusWeight c) :=
  Ovoid.torusPerm_affineMk c x y

@[simp] theorem weylElement_smul_infinity (m : ℕ) :
    weylElement m • Ovoid.infinity m = Ovoid.origin m :=
  Ovoid.weylPerm_infinity m

@[simp] theorem weylElement_smul_origin (m : ℕ) :
    weylElement m • Ovoid.origin m = Ovoid.infinity m :=
  Ovoid.weylPerm_origin m

theorem weylElement_smul_affine_of_ne_one {m : ℕ}
    (u : RootGroup m) (hu : u ≠ 1) :
    weylElement m • Ovoid.affine u = Ovoid.affine (Ovoid.weylAffine u) :=
  Ovoid.weylPerm_affine_of_ne_one u hu

theorem weylElement_smul_affineMk_of_ne_zero {m : ℕ}
    {x y : Field m} (hxy : ¬(x = 0 ∧ y = 0)) :
    weylElement m • Ovoid.affineMk x y =
      Ovoid.affineMk (y / suzukiNorm m x y) (x / suzukiNorm m x y) :=
  Ovoid.weylPerm_affineMk_of_ne_zero hxy

/-- The Weyl generator is an involution inside the generated subgroup. -/
theorem weylElement_sq_eq_one (m : ℕ) : weylElement m ^ 2 = 1 := by
  apply Subtype.ext
  apply Equiv.Perm.ext
  intro p
  change Ovoid.weylPerm m (Ovoid.weylPerm m p) = p
  exact Ovoid.weylPerm_apply_apply m p

/-- The torus-root conjugation relation holds inside the generated subgroup. -/
theorem torusHom_mul_rootHom_mul_inv {m : ℕ}
    (c : TorusParameter m) (u : RootGroup m) :
    torusHom m c * rootHom m u * (torusHom m c)⁻¹ =
      rootHom m (torusScale c u) := by
  apply Subtype.ext
  exact Ovoid.torusPerm_mul_rootPerm_mul_inv c u

open MulAction

/-- Every ovoid point can be carried to infinity by an element of the
standard generated group. -/
theorem standardPermGroup_exists_smul_eq_infinity (m : ℕ) (p : Ovoid m) :
    ∃ g : standardPermGroup m, g • p = Ovoid.infinity m := by
  cases p with
  | none => exact ⟨1, one_smul _ _⟩
  | some u =>
      refine ⟨weylElement m * rootHom m u⁻¹, ?_⟩
      change Ovoid.weylPerm m
        (Ovoid.rootPermHom m u⁻¹ (Ovoid.affine u)) = Ovoid.infinity m
      rw [Ovoid.rootPermHom_apply_affine, inv_mul_cancel]
      exact Ovoid.weylPerm_origin m

/-- The standard generated group is transitive on the Suzuki ovoid. -/
theorem standardPermGroup_isPretransitive (m : ℕ) :
    IsPretransitive (standardPermGroup m) (Ovoid m) where
  exists_smul_eq a b := by
    obtain ⟨ga, hga⟩ := standardPermGroup_exists_smul_eq_infinity m a
    obtain ⟨gb, hgb⟩ := standardPermGroup_exists_smul_eq_infinity m b
    refine ⟨gb⁻¹ * ga, ?_⟩
    rw [mul_smul, hga, inv_smul_eq_iff, hgb]

/-- The stabilizer of infinity is transitive on the affine chart.  Concretely,
the root translations act regularly there. -/
theorem standardPermGroup_infinityStabilizer_isPretransitive (m : ℕ) :
    IsPretransitive (stabilizer (standardPermGroup m) (Ovoid.infinity m))
      (SubMulAction.ofStabilizer (standardPermGroup m) (Ovoid.infinity m)) where
  exists_smul_eq x y := by
    rcases x with ⟨p, hp⟩
    rcases y with ⟨q, hq⟩
    cases p with
    | none => exact (hp rfl).elim
    | some u =>
      cases q with
      | none => exact (hq rfl).elim
      | some v =>
        let r : standardPermGroup m := rootHom m (v * u⁻¹)
        have hr : r ∈ stabilizer (standardPermGroup m) (Ovoid.infinity m) := by
          rw [mem_stabilizer_iff]
          change Ovoid.rootPermHom m (v * u⁻¹) (Ovoid.infinity m) =
            Ovoid.infinity m
          exact Ovoid.rootPermHom_apply_infinity _
        refine ⟨⟨r, hr⟩, ?_⟩
        apply Subtype.ext
        change Ovoid.rootPermHom m (v * u⁻¹) (Ovoid.affine u) = Ovoid.affine v
        rw [Ovoid.rootPermHom_apply_affine, mul_assoc, inv_mul_cancel, mul_one]

/-- The standard action of the generated Suzuki permutation group is doubly
transitive. -/
theorem standardPermGroup_isMultiplyPretransitive (m : ℕ) :
    IsMultiplyPretransitive (standardPermGroup m) (Ovoid m) 2 := by
  letI : IsPretransitive (standardPermGroup m) (Ovoid m) :=
    standardPermGroup_isPretransitive m
  rw [show (2 : ℕ) = Nat.succ 1 by rfl,
    SubMulAction.ofStabilizer.isMultiplyPretransitive (a := Ovoid.infinity m),
    MulAction.is_one_pretransitive_iff]
  exact standardPermGroup_infinityStabilizer_isPretransitive m

end OddOrder.GroupTheory.SpecificGroups.Suzuki
