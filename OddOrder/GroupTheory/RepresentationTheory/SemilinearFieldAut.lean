import Mathlib.Algebra.Ring.Equiv
import Mathlib.Algebra.Ring.Aut
import Mathlib.Algebra.Group.End
import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.Algebra.Ring.AddAut
import Mathlib.FieldTheory.Finite.GaloisField

/-!
# Semilinear extension: additive automorphisms multiplicative on a generating scalar set

Abstract layer for **Peterfalvi (9.7.b)** (LMS LNS 272, p. 52; issue 1043): the map `η(w)`
transported from the `W₁`-action on the chief factor `H̄ ≅ F = GF(p^q)` is a priori only an
*additive* automorphism of `F`; the book upgrades it to a **field automorphism** from two facts:

* the twist identity `η(w)(t·ψ(x)) = η(w)(t)·η(w)(ψ(x))` — multiplicativity against the scalar
  image `U* = ψ(Ū)` (derived from the `W₂`-base-point normalization `s^w = s`);
* `U*` generates `F` **additively** ("the additive subgroup of `F` generated by `U*` is `F`",
  from the irreducibility of the `U`-action).

This file proves the abstract upgrade: an additive automorphism `α : F ≃+ F` of a ring that is
multiplicative against every element of an additively-generating set `S` is fully multiplicative
(`addEquiv_mul_of_mul_scalars` — for fixed `t`, the set `{t' | α (t·t') = α t · α t'}` is an
additive subgroup containing `S`), hence a ring automorphism (`ringEquivOfAddEquivOfMulScalars`;
`map_one` is automatic for a `RingEquiv`).  A pointwise family version packages a group's worth
of such automorphisms into `W →* RingAut F` (`ringAutHomOfAddAutHom`), preserving injectivity.

The `hgen` hypothesis it needs is itself supplied abstractly by
`addSubgroup_closure_eq_top_of_irreducible`: the additive closure of a multiplicatively closed
set is automatically stable under that set, so irreducibility leaves it no room to be proper.

The second half supplies the **counting** half of (9.7.b): the book concludes `W₁ ≅ Aut F` from
injectivity plus `|Aut F| = q = |W₁|`.  A ring automorphism of a field fixes the prime subfield
automatically, so `RingAut F` *is* the Galois group over `𝔽_p` (`ringAutMulEquivAlgAut`), and for
a finite field its order is the degree (`natCard_ringAut_eq_finrank`), i.e. `q` for `GF(p^q)`
(`natCard_ringAut_galoisField`).

The concrete (9.7.b) wiring — the base-point normalization of the Galois-field model
`caseB_exists_galoisField_repr`, the twist identity from `W̄₂ = C_{H̄}(W₁)`, and the additive
generation from irreducibility — lives on the S11 side (issue 1043).
-/

namespace OddOrder.RepresentationTheory

variable {F : Type*} [Ring F]

/-- **Multiplicativity from a generating scalar set**: an additive automorphism `α` that is
multiplicative against every element of `S` (`α (t·s) = α t · α s`) is multiplicative against
every element of the additive closure of `S`; if `S` generates `F` additively, against
everything.  For fixed `t`, the set `{t' | α (t·t') = α t · α t'}` is an additive subgroup
(distributivity + additivity of `α`) containing `S`. -/
theorem addEquiv_mul_of_mul_scalars (α : F ≃+ F) {S : Set F}
    (hgen : AddSubgroup.closure S = ⊤)
    (hmul : ∀ s ∈ S, ∀ t : F, α (t * s) = α t * α s) (t t' : F) :
    α (t * t') = α t * α t' := by
  have hmem : t' ∈ AddSubgroup.closure S := hgen ▸ AddSubgroup.mem_top t'
  induction hmem using AddSubgroup.closure_induction with
  | mem s hs => exact hmul s hs t
  | zero => simp
  | add x y _ _ hpx hpy => rw [mul_add, map_add, hpx, hpy, map_add, mul_add]
  | neg x _ hpx => rw [mul_neg, map_neg, hpx, map_neg, mul_neg]

/-- **The semilinear-extension ring automorphism** (Peterfalvi (9.7.b), abstract form): an
additive automorphism multiplicative against an additively-generating scalar set is a ring
automorphism.  (`map_one` needs no hypothesis: a multiplicative-and-additive equiv of a ring
preserves `1` automatically.) -/
def ringEquivOfAddEquivOfMulScalars (α : F ≃+ F) {S : Set F}
    (hgen : AddSubgroup.closure S = ⊤)
    (hmul : ∀ s ∈ S, ∀ t : F, α (t * s) = α t * α s) : F ≃+* F :=
  { α with
    map_mul' := addEquiv_mul_of_mul_scalars α hgen hmul }

@[simp] theorem ringEquivOfAddEquivOfMulScalars_apply (α : F ≃+ F) {S : Set F}
    (hgen : AddSubgroup.closure S = ⊤)
    (hmul : ∀ s ∈ S, ∀ t : F, α (t * s) = α t * α s) (x : F) :
    ringEquivOfAddEquivOfMulScalars α hgen hmul x = α x := rfl

/-- **Group-level packaging** (the `η : W₁ →* Aut F` of Peterfalvi (9.7.b)): a homomorphism into
the additive automorphisms whose every value is multiplicative against a common
additively-generating scalar set upgrades to a homomorphism into the **ring** automorphisms,
with the same underlying functions.

`AddAut F` is an *additive* group in mathlib, so the source is its multiplicative incarnation
`Multiplicative (AddAut F)` (the same idiom as `AddAut.toZModLinearEquiv` in
`OddOrder/GroupTheory/PRank.lean` and `AddAut.mulLeft` in `OddOrder/BG/AppC_NormSet.lean`).
Both group laws are function composition, so the two `rfl`s below are the real content. -/
def ringAutHomOfAddAutHom {W : Type*} [Group W] (η : W →* Multiplicative (AddAut F))
    {S : Set F} (hgen : AddSubgroup.closure S = ⊤)
    (hmul : ∀ w : W, ∀ s ∈ S, ∀ t : F, Multiplicative.toAdd (η w) (t * s)
      = Multiplicative.toAdd (η w) t * Multiplicative.toAdd (η w) s) :
    W →* RingAut F where
  toFun w := ringEquivOfAddEquivOfMulScalars (Multiplicative.toAdd (η w)) hgen (hmul w)
  map_one' := by
    refine RingEquiv.ext fun x => ?_
    rw [ringEquivOfAddEquivOfMulScalars_apply, map_one η]
    rfl
  map_mul' w w' := by
    refine RingEquiv.ext fun x => ?_
    rw [ringEquivOfAddEquivOfMulScalars_apply, map_mul η]
    rfl

@[simp] theorem ringAutHomOfAddAutHom_apply {W : Type*} [Group W]
    (η : W →* Multiplicative (AddAut F))
    {S : Set F} (hgen : AddSubgroup.closure S = ⊤)
    (hmul : ∀ w : W, ∀ s ∈ S, ∀ t : F, Multiplicative.toAdd (η w) (t * s)
      = Multiplicative.toAdd (η w) t * Multiplicative.toAdd (η w) s) (w : W) (x : F) :
    ringAutHomOfAddAutHom η hgen hmul w x = Multiplicative.toAdd (η w) x := rfl

/-- The ring-automorphism packaging preserves injectivity: distinct `W`-elements with distinct
additive actions stay distinct as ring automorphisms (same underlying functions). -/
theorem ringAutHomOfAddAutHom_injective {W : Type*} [Group W]
    (η : W →* Multiplicative (AddAut F))
    {S : Set F} (hgen : AddSubgroup.closure S = ⊤)
    (hmul : ∀ w : W, ∀ s ∈ S, ∀ t : F, Multiplicative.toAdd (η w) (t * s)
      = Multiplicative.toAdd (η w) t * Multiplicative.toAdd (η w) s)
    (hinj : Function.Injective η) :
    Function.Injective (ringAutHomOfAddAutHom η hgen hmul) := by
  intro w w' h
  apply hinj
  refine Multiplicative.toAdd.injective (AddEquiv.ext fun x => ?_)
  have := congrArg (fun f : RingAut F => f x) h
  simpa using this

/-! ## Additive generation by the scalar group

The other input to the upgrade is Peterfalvi's "the additive subgroup of `F` generated by `U*`
is `F`", which he reads off from irreducibility of the `U`-action.  Abstractly: the additive
closure of a multiplicatively closed set is automatically stable under multiplication by that
set, so irreducibility leaves it no room to be proper.
-/

section AdditiveGeneration

/-- The additive closure of a multiplicatively closed set `S` is stable under multiplication by
elements of `S` (distributivity plus additivity, by closure induction). -/
theorem mul_mem_addSubgroup_closure {S : Set F}
    (hmulS : ∀ a ∈ S, ∀ b ∈ S, a * b ∈ S) {s : F} (hs : s ∈ S) {t : F}
    (ht : t ∈ AddSubgroup.closure S) : s * t ∈ AddSubgroup.closure S := by
  induction ht using AddSubgroup.closure_induction with
  | mem b hb => exact AddSubgroup.subset_closure (hmulS s hs b hb)
  | zero => simp
  | add x y _ _ hx hy => rw [mul_add]; exact add_mem hx hy
  | neg x _ hx => rw [mul_neg]; exact neg_mem hx

/-- **`U*` generates `F` additively** (Peterfalvi (9.7.b)).  A multiplicatively closed set `S`
containing `1` has an additive closure that is `S`-stable and nonzero, so an irreducibility
hypothesis for `S`-stable additive subgroups forces it to be all of `F`.

The caller supplies `hirr` by transporting the module-level irreducibility of the `U`-action on
`H̄` across the field model. -/
theorem addSubgroup_closure_eq_top_of_irreducible [Nontrivial F] {S : Set F}
    (hone : (1 : F) ∈ S) (hmulS : ∀ a ∈ S, ∀ b ∈ S, a * b ∈ S)
    (hirr : ∀ A : AddSubgroup F, (∀ s ∈ S, ∀ a ∈ A, s * a ∈ A) → A = ⊥ ∨ A = ⊤) :
    AddSubgroup.closure S = ⊤ := by
  rcases hirr (AddSubgroup.closure S)
      (fun _ hs _ ha => mul_mem_addSubgroup_closure hmulS hs ha) with hbot | htop
  · exact absurd (hbot ▸ AddSubgroup.subset_closure hone) one_ne_zero
  · exact htop

end AdditiveGeneration

/-! ## Base-point normalization of a scalar field model

Peterfalvi (9.7.b) picks `s ∈ W̄₂^#` and takes for `φ : H̄ → F` the additive isomorphism
determined by `h = s·φ(h)` — in particular `φ(s) = 1`.  That normalization is what makes the
twist identity collapse: substituting `h = s` into
`(φ(h)ψ(x))η(w) = (φ(h)η(w))ψ(w⁻¹xw)` gives `ψ(x)η(w) = ψ(w⁻¹xw)`.

A model produced by the Singer construction is *not* normalized, but normalizing costs nothing:
rescaling by the unit `(e s)⁻¹` is an additive automorphism of `F` that commutes past the
scalars (`F` is commutative), so it preserves the intertwining property.
-/

section BasePoint

/-- **Base-point normalization.**  Given an additive model `e : M ≃+ F` intertwining a scalar
action (`e (act c x) = μ c * e x`) and a base point `s` with `e s ≠ 0`, rescaling by `(e s)⁻¹`
produces a model with the *same* scalars in which `s ↦ 1`.

This supplies the `φ(s) = 1` normalization of Peterfalvi (9.7.b) from the unnormalized model that
the Singer construction returns. -/
theorem exists_normalized_of_scalar_model {M F : Type*} [Add M] [Field F]
    {C : Type*} (act : C → M → M) (e : M ≃+ F) (μ : C → Fˣ)
    (hcompat : ∀ (c : C) (x : M), e (act c x) = (μ c : F) * e x)
    {s : M} (hs : e s ≠ 0) :
    ∃ e' : M ≃+ F, (∀ (c : C) (x : M), e' (act c x) = (μ c : F) * e' x) ∧ e' s = 1 := by
  refine ⟨e.trans (Multiplicative.toAdd (AddAut.mulLeft (Units.mk0 (e s) hs)⁻¹)), ?_, ?_⟩
  · intro c x
    change ((Units.mk0 (e s) hs)⁻¹ : F) * e (act c x)
      = (μ c : F) * (((Units.mk0 (e s) hs)⁻¹ : F) * e x)
    rw [hcompat c x]
    ring
  · change ((Units.mk0 (e s) hs)⁻¹ : F) * e s = 1
    exact inv_mul_cancel₀ hs

end BasePoint

/-! ## The order of `Aut F` for a finite field

Peterfalvi (9.7.b) finishes by counting: `η : W₁ →* Aut F` is injective and `|W₁| = q = |Aut F|`,
hence `η` is onto.  This section supplies the `|Aut F| = q` half.
-/

section FiniteFieldAut

variable (F : Type*) [Field F] (p : ℕ) [Fact p.Prime] [Algebra (ZMod p) F]

/-- **A ring automorphism of a field fixes the prime subfield**, so `RingAut F` *is* the
`𝔽_p`-algebra automorphism group — the Galois group of `F/𝔽_p` — with the same underlying
functions.  (Every element of `ZMod p` is an integer cast, and ring homs preserve integer casts;
both group laws are composition, so all four structure fields are `rfl`.)

This is the reusable form of the bridge currently inlined as a `let` inside the proof of
`ringAut_isCyclic_of_finite` in `OddOrder/Peterfalvi/Appendices/Suzuki/SemilinearModel.lean`. -/
def ringAutMulEquivAlgAut : RingAut F ≃* (F ≃ₐ[ZMod p] F) where
  toFun f := AlgEquiv.ofRingEquiv (f := f) fun x => by
    obtain ⟨n, rfl⟩ := ZMod.intCast_surjective x
    simp
  invFun g := g.toRingEquiv
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl

@[simp] theorem ringAutMulEquivAlgAut_apply (f : RingAut F) (x : F) :
    ringAutMulEquivAlgAut F p f x = f x := rfl

/-- **`|Aut F| = [F : 𝔽_p]` for a finite field.**  A finite extension of a finite field is
automatically Galois, so the Galois group has order the degree; `ringAutMulEquivAlgAut`
identifies it with `RingAut F`. -/
theorem natCard_ringAut_eq_finrank [Finite F] :
    Nat.card (RingAut F) = Module.finrank (ZMod p) F := by
  rw [Nat.card_congr (ringAutMulEquivAlgAut F p).toEquiv]
  exact IsGalois.card_aut_eq_finrank (ZMod p) F

/-- **`|Aut GF(p^q)| = q`** — the counting input to Peterfalvi (9.7.b)'s `W₁ ≅ Aut F`.  Together
with injectivity of `η` and `|W₁| = q`, this forces `η : W₁ →* RingAut F` to be an isomorphism
onto `Aut F`. -/
theorem natCard_ringAut_galoisField (q : ℕ) (hq : q ≠ 0) :
    Nat.card (RingAut (GaloisField p q)) = q := by
  rw [natCard_ringAut_eq_finrank (GaloisField p q) p, GaloisField.finrank p hq]

end FiniteFieldAut

end OddOrder.RepresentationTheory
