import OddOrder.GroupTheory.RepresentationTheory.VirtualCharacterInduction

/-!
# `v(G)` is an ideal of `ch(G)` — Gorenstein Lemma 7.3

For a family `𝒳` of subgroups of `G`, Gorenstein's

`v(G) = ∑_{E ∈ 𝒳} ch(E)^*`

is the additive group generated by the characters induced from virtual characters of the members
of `𝒳`.  Lemma 7.3 says it is an **ideal** of `ch(G)`, and that is the whole reason the
Brauer–Tate argument works: to prove `v(G) = ch(G)` it then suffices to produce `1_G ∈ v(G)`.

The proof is one line of the projection formula (`induceFun_mul_restrict`, Gorenstein Lemma 7.2):
`(Ind_E^G ψ) · θ = Ind_E^G (ψ · Res_E θ)`, and `ψ · Res_E θ` is again a virtual character of `E`.

The family `𝒳` is kept as a **parameter** rather than fixed to the elementary subgroups.  Doing so
costs nothing here and makes the eventual induction theorem usable by a caller who can only check
a weaker membership condition (Navarro (2.15), for instance, verifies its hypothesis for every
subgroup of the shape `p`-group × `p'`-group, which is more than the elementary ones).

## Main definitions

* `OddOrder.RepresentationTheory.inducedCharacterSet` — the generators `{Ind_E^G ψ}`
* `OddOrder.RepresentationTheory.inducedVirtualCharacters` — Gorenstein's `v(G)`

## Main results

* `OddOrder.RepresentationTheory.virtualCharacters_conj` — virtual characters are class functions
* `OddOrder.RepresentationTheory.mul_mem_inducedVirtualCharacters` — **Lemma 7.3**

## References

* D. Gorenstein, *Finite Groups*, §4.7, Lemma 7.3 (`references/gorenstein/pages/`).
-/

namespace OddOrder.RepresentationTheory

variable {K G : Type*} [Field K] [Group G]

/-- **Virtual characters are class functions.**  Characters are (`Representation.char_conj`), and
the property passes to `ℤ`-combinations. -/
theorem virtualCharacters_conj {θ : G → K} (hθ : θ ∈ virtualCharacters K G) (g h : G) :
    θ (h * g * h⁻¹) = θ g := by
  induction hθ using AddSubgroup.closure_induction with
  | mem θ hθ =>
      obtain ⟨n, ρ, rfl⟩ := hθ
      exact ρ.char_conj g h
  | zero => rfl
  | add a b _ _ ha hb => exact congrArg₂ (· + ·) ha hb
  | neg a _ ha => exact congrArg Neg.neg ha

variable [Fintype G]

variable (K) in
/-- The generating set of `v(G)`: the characters induced from virtual characters of the members of
the family `𝒳`. -/
def inducedCharacterSet (𝒳 : Set (Subgroup G)) : Set (G → K) :=
  { f | ∃ E ∈ 𝒳, ∃ ψ ∈ virtualCharacters K ↥E, f = induceFun E ψ }

variable (K) in
/-- **Gorenstein's `v(G) = ∑_{E ∈ 𝒳} ch(E)^*`.** -/
def inducedVirtualCharacters (𝒳 : Set (Subgroup G)) : AddSubgroup (G → K) :=
  AddSubgroup.closure (inducedCharacterSet K 𝒳)

variable {𝒳 : Set (Subgroup G)}

theorem induceFun_mem_inducedVirtualCharacters {E : Subgroup G} (hE : E ∈ 𝒳) {ψ : ↥E → K}
    (hψ : ψ ∈ virtualCharacters K ↥E) : induceFun E ψ ∈ inducedVirtualCharacters K 𝒳 :=
  AddSubgroup.subset_closure ⟨E, hE, ψ, hψ, rfl⟩

/-- **Gorenstein Lemma 7.3: `v(G)` is an ideal of `ch(G)`.**  Immediate from the projection
formula: `(Ind_E^G ψ) · θ = Ind_E^G (ψ · Res_E θ)`, and `ψ · Res_E θ ∈ ch(E)`. -/
theorem mul_mem_inducedVirtualCharacters {w θ : G → K} (hw : w ∈ inducedVirtualCharacters K 𝒳)
    (hθ : θ ∈ virtualCharacters K G) : w * θ ∈ inducedVirtualCharacters K 𝒳 := by
  induction hw using AddSubgroup.closure_induction with
  | mem w hw =>
      obtain ⟨E, hE, ψ, hψ, rfl⟩ := hw
      rw [← induceFun_mul_restrict ψ (fun g h => virtualCharacters_conj hθ g h)]
      exact induceFun_mem_inducedVirtualCharacters hE
        (mul_mem_virtualCharacters hψ (comp_mem_virtualCharacters E.subtype hθ))
  | zero => simpa only [zero_mul] using (inducedVirtualCharacters K 𝒳).zero_mem
  | add a b _ _ ha hb => simpa only [add_mul] using (inducedVirtualCharacters K 𝒳).add_mem ha hb
  | neg a _ ha => simpa only [neg_mul] using (inducedVirtualCharacters K 𝒳).neg_mem ha

/-- Elements of `v(G)` are class functions. -/
theorem inducedVirtualCharacters_conj {w : G → K} (hw : w ∈ inducedVirtualCharacters K 𝒳)
    (g h : G) : w (h * g * h⁻¹) = w g := by
  induction hw using AddSubgroup.closure_induction with
  | mem w hw =>
      obtain ⟨E, _, ψ, _, rfl⟩ := hw
      exact induceFun_conj ψ g h
  | zero => rfl
  | add a b _ _ ha hb => exact congrArg₂ (· + ·) ha hb
  | neg a _ ha => exact congrArg Neg.neg ha

end OddOrder.RepresentationTheory
