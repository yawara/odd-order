import Mathlib.RepresentationTheory.Basic
import Mathlib.RepresentationTheory.Irreducible
import Mathlib.RepresentationTheory.AlgebraRepresentation.Basic
import Mathlib.RingTheory.SimpleModule.Basic
import Mathlib.RingTheory.SimpleModule.IsAlgClosed
import Mathlib.RingTheory.Finiteness.Basic
import Mathlib.FieldTheory.IsAlgClosed.Basic

/-!
# Burnside's theorem over an algebraically closed field (BG §2 Prop 2.1)

`OddOrder.GroupTheory.RepresentationTheory` shared module: the
**Bender-Glauberman §2 Prop 2.1 / Burnside** statement that for a faithful
absolutely irreducible representation the *enveloping algebra* — the image of
the group ring inside `End_F V` — is the whole of `End_F V`.

We prove the general module-theoretic form: if `M` is a finite-dimensional
simple module over an `F`-algebra `A`, with `F` algebraically closed, then the
structure ring hom `A → End_F M` (sending `a` to the `F`-linear map `m ↦ a • m`)
is **surjective**.

## Proof

This is the classical Burnside theorem, and over an algebraically closed field
it follows directly from two facts already in mathlib:

* **Schur's lemma** (`IsSimpleModule.algebraMap_end_bijective_of_isAlgClosed`):
  over an algebraically closed `F`, the commutant `D := End_A M` is just the
  scalars, i.e. `algebraMap F D` is bijective.
* **The Jacobson density theorem**
  (`Module.Finite.toModuleEnd_moduleEnd_surjective`): for a semisimple module
  finite over its endomorphism ring `D`, the map `A → End_D M` is surjective.

Since `D = F` (scalars), an `F`-linear endomorphism of `M` is automatically
`D`-linear, so `End_D M = End_F M`, and Jacobson density becomes exactly the
surjectivity of `A → End_F M`.

## BG ↔ mathlib mapping

* **BG Thm 2.5** uses this as `E(P) = Hom_F(V, V)` for a faithful irreducible
  `V` of an extraspecial group `P` over an algebraically closed field.
  Faithfulness is *not* needed for surjectivity — simplicity suffices.
-/

namespace OddOrder.RepresentationTheory

open Module

section Burnside

variable {F : Type*} [Field F] [IsAlgClosed F]
variable {A : Type*} [Ring A] [Algebra F A]
variable {M : Type*} [AddCommGroup M] [Module F M] [Module A M] [IsScalarTower F A M]
variable [IsSimpleModule A M] [FiniteDimensional F M]

/-- **Burnside's theorem** (BG Prop 2.1, module form): for a finite-dimensional
simple module `M` over an `F`-algebra `A` with `F` algebraically closed, the
structure ring hom `A → End_F M`, `a ↦ (m ↦ a • m)`, is surjective.

Equivalently: the *enveloping algebra* — the `F`-subalgebra of `End_F M`
generated by the image of `A` — is the whole of `End_F M`. -/
theorem toModuleEnd_surjective_of_isAlgClosed :
    Function.Surjective (Module.toModuleEnd F M (S := A)) := by
  classical
  -- `F` commutes with `A` on `M` (both act through the central image of `F`).
  haveI : SMulCommClass A F M := ⟨fun a c m => by
    rw [← IsScalarTower.algebraMap_smul A c m, ← IsScalarTower.algebraMap_smul A c (a • m),
        smul_smul, smul_smul, Algebra.commutes]⟩
  -- `M` is finite over the (bigger) endomorphism ring `D := End_A M`.
  haveI : Module.Finite (Module.End A M) M :=
    Module.Finite.of_restrictScalars_finite F (Module.End A M) M
  -- Schur over an algebraically closed field: `D = End_A M` is just the scalars.
  have hSchur : Function.Surjective (algebraMap F (Module.End A M)) :=
    (IsSimpleModule.algebraMap_end_bijective_of_isAlgClosed (A := A) (V := M) F).2
  -- The scalar action of `D` on `M` agrees with the `F`-action.
  have key : ∀ (c : F) (x : M), (algebraMap F (Module.End A M) c) • x = c • x := by
    intro c x
    rw [Module.End.smul_def, Algebra.algebraMap_eq_smul_one, LinearMap.smul_apply,
      Module.End.one_apply]
  intro g
  -- Realise `g : End_F M` as a `D`-linear map, using that every `d ∈ D` is a scalar.
  let g' : M →ₗ[Module.End A M] M :=
    { toFun := g
      map_add' := g.map_add
      map_smul' := by
        intro d m
        obtain ⟨c, hc⟩ := hSchur d
        simp only [RingHom.id_apply, ← hc, key c m, key c (g m), map_smul] }
  -- Jacobson density: `A → End_D M` is surjective; pull back `g'`.
  obtain ⟨a, ha⟩ := Module.Finite.toModuleEnd_moduleEnd_surjective (R := A) (M := M) g'
  refine ⟨a, ?_⟩
  ext m
  have hm := LinearMap.congr_fun ha m
  simpa using hm

end Burnside

end OddOrder.RepresentationTheory
