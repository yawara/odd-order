import Mathlib.GroupTheory.Sylow
import Mathlib.GroupTheory.Index

/-!
# A subgroup containing a full Sylow subgroup for every prime is everything

`eq_top_of_forall_exists_sylow_le`: if `H ≤ G` contains, for each prime `r`, some Sylow
`r`-subgroup of `G`, then `H = ⊤`.

The usual way this arises is that one proves `H` centralizes or normalizes enough of `G` to
absorb every Sylow subgroup; this lemma turns that into `H = ⊤` without having to know that `G`
is generated by its Sylow subgroups.
-/

namespace OddOrder.GroupTheory

variable {G : Type*} [Group G]

/-- A subgroup that contains a Sylow `r`-subgroup for every prime `r` is the whole group.

If a prime `r` divided `[G : H]`, then the `r`-part of `|H|` would be strictly smaller than the
`r`-part of `|G|`; but `H` contains a full Sylow `r`-subgroup, whose order is exactly the
`r`-part of `|G|`. -/
theorem eq_top_of_forall_exists_sylow_le [Finite G] {H : Subgroup G}
    (h : ∀ r : ℕ, r.Prime → ∃ P : Sylow r G, (P : Subgroup G) ≤ H) : H = ⊤ := by
  rw [← Subgroup.index_eq_one]
  by_contra hne
  obtain ⟨r, hr, hrdvd⟩ := Nat.exists_prime_and_dvd hne
  haveI : Fact r.Prime := ⟨hr⟩
  obtain ⟨P, hPH⟩ := h r hr
  -- `|P|` is the full `r`-part of `|G|`, and it divides `|H|`.
  have hPcard : Nat.card ↥(P : Subgroup G) = r ^ (Nat.card G).factorization r :=
    P.card_eq_multiplicity
  have hPfac : (Nat.card G).factorization r ≤ (Nat.card ↥H).factorization r := by
    have hdvd : Nat.card ↥(P : Subgroup G) ∣ Nat.card ↥H := Subgroup.card_dvd_of_le hPH
    have hPne : Nat.card ↥(P : Subgroup G) ≠ 0 := by
      rw [hPcard]; exact pow_ne_zero _ hr.pos.ne'
    have := (Nat.factorization_le_iff_dvd hPne Nat.card_pos.ne').mpr hdvd
    simpa [hPcard, Nat.Prime.factorization_pow hr] using this r
  -- but `r` divides the index, so the `r`-part of `|H|` is strictly smaller.
  have hmul : Nat.card ↥H * H.index = Nat.card G := Subgroup.card_mul_index H
  have hsplit : (Nat.card G).factorization r
      = (Nat.card ↥H).factorization r + H.index.factorization r := by
    rw [← hmul, Nat.factorization_mul Nat.card_pos.ne' Subgroup.index_ne_zero_of_finite]
    simp
  have hidx : 1 ≤ H.index.factorization r :=
    (Nat.Prime.factorization_pos_of_dvd hr Subgroup.index_ne_zero_of_finite hrdvd)
  omega

end OddOrder.GroupTheory
