import OddOrder.Peterfalvi.Appendices.Suzuki.FirstCase.StepFifteenLV

/-!
# Peterfalvi Part II, Ch. II, step (16)

T. Peterfalvi, *Character Theory for the Odd Order Theorem* (LMS LNS 272,
2000), Part II, Ch. II, (16), p. 114.

> **(16)** `Z₁PΣ ⊆ Z₂(R₁)`, `Z₁` is the only subgroup of order `3` in `Z₁PΣ` consisting
> of strongly real elements, and `N_G(Z₁PΣ) = N_G(Z₁) = R₂⟨s⟩`.

This file collects the structural facts about `R₁` that the proof needs.  The first is
that `L` fills up `R₁` over `RΣ`: `RΣ` has index `3` in `R₁` by (14), and `L ⊄ RΣ`
by (15), so `R₁ = RΣL`.
-/

set_option autoImplicit false

open scoped Pointwise

namespace OddOrder.Peterfalvi.Appendices.Suzuki

namespace FirstCaseHypothesis

universe uG uΩ

variable {G : Type uG} {Ω : Type uΩ} [Group G] [MulAction G Ω] [Finite G]
  (fc : FirstCaseHypothesis G Ω)
  {F : Type uG} [NearFields.NearField F]
  (model : letI := fc.toHypothesis.centralizerQuotientMulAction fc.P_le_V
    NearFields.AffineNearFieldModel fc.rankOneQuotient F)

include model in
/-- **`R₁ = RΣL`** (implicit in (16)/(17), p. 114: "`R₁` is generated by the subgroups
`RΣ` and `LΣP` since `L ⊄ RΣ`").

`|RΣ| = 3⁴` and `|R₁| = 3⁵` by (14), so `RΣ` is maximal in `R₁`; and `L ≤ R₁` but
`L ⊄ RΣ` by (15). -/
theorem sup_invImageF_centralizer_W_sup_nonsplitTorus_eq
    (ind : Hypothesis.TheoremAInductionBelow G Ω)
    (hB2 : ¬ fc.p ∣ Nat.card (Abelianization G)) :
    (fc.invImageF model ⊔ (fc.toHypothesis.W ⊓ Subgroup.centralizer (fc.P : Set G)))
        ⊔ fc.nonsplitTorus
      = fc.sylowThreeNormalizerRSigma model := by
  letI := fc.toHypothesis.centralizerQuotientMulAction fc.P_le_V
  classical
  have hRScard := fc.card_sup_invImageF_centralizer_W_eq model ind hB2
  have hR₁card := fc.card_sylowThreeNormalizerRSigma model ind hB2
  have hle : (fc.invImageF model
        ⊔ (fc.toHypothesis.W ⊓ Subgroup.centralizer (fc.P : Set G)))
      ⊔ fc.nonsplitTorus ≤ fc.sylowThreeNormalizerRSigma model :=
    sup_le (fc.sup_le_sylowThreeNormalizerRSigma model ind hB2)
      (fc.nonsplitTorus_le_sylowThreeNormalizerRSigma model ind hB2)
  -- the order of `RΣL` is a multiple of `3⁴` dividing `3⁵`
  obtain ⟨m, hm⟩ := Subgroup.card_dvd_of_le
    (le_sup_left : (fc.invImageF model
        ⊔ (fc.toHypothesis.W ⊓ Subgroup.centralizer (fc.P : Set G)))
      ≤ _ ⊔ fc.nonsplitTorus)
  have hdvd : Nat.card ↥((fc.invImageF model
      ⊔ (fc.toHypothesis.W ⊓ Subgroup.centralizer (fc.P : Set G)))
        ⊔ fc.nonsplitTorus) ∣ 3 ^ 5 := by
    rw [← hR₁card]
    exact Subgroup.card_dvd_of_le hle
  have hm3 : m ∣ 3 := by
    rw [hm, hRScard] at hdvd
    refine (Nat.mul_dvd_mul_iff_left (show 0 < 3 ^ 4 by norm_num)).mp ?_
    calc 3 ^ 4 * m ∣ 3 ^ 5 := hdvd
      _ = 3 ^ 4 * 3 := by norm_num
  rcases (Nat.dvd_prime (by norm_num)).mp hm3 with h1 | h3
  · -- `RΣL = RΣ` would put `L` inside `RΣ`
    exfalso
    refine fc.not_nonsplitTorus_le_sup_invImageF_centralizer_W model ind hB2 ?_
    have heq : (fc.invImageF model
          ⊔ (fc.toHypothesis.W ⊓ Subgroup.centralizer (fc.P : Set G)))
        ⊔ fc.nonsplitTorus
        = fc.invImageF model
          ⊔ (fc.toHypothesis.W ⊓ Subgroup.centralizer (fc.P : Set G)) :=
      (Subgroup.eq_of_le_of_card_ge le_sup_left (by rw [hm, h1, mul_one])).symm
    rw [← heq]
    exact le_sup_right
  · refine Subgroup.eq_of_le_of_card_ge hle ?_
    rw [hm, h3, hRScard, hR₁card]
    norm_num

end FirstCaseHypothesis

end OddOrder.Peterfalvi.Appendices.Suzuki
