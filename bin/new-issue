#!/usr/bin/env bash
# bin/new-issue [--base N] <slug> <title>
#
# 新規 issue を採番して issues/NNNN-<slug>.md に scaffold を作る.
#
# - 並行セッションの採番衝突回避のためレンジを分ける (--base / $ODD_ISSUE_BASE):
#     base 0    → main/trunk セッション (0000-0999, SEQUENCE)
#     base 1000 → 並行セッション #1      (1000-1999, SEQUENCE.1000)
#     base 2000 → 並行セッション #2      (2000-2999, SEQUENCE.2000) ...
#   base は 100 の倍数. 1000 の倍数ならレンジ幅 1000, それ以外は幅 100.
#   レンジごとに別 SEQUENCE ファイルを使うので, ブランチ越しでも採番もマージも
#   衝突しない. レンジを使い切ったらエラーで知らせる (= 再分割を検討する
#   タイミング, notes/meta/issue_management.md).
# - ⚠ shared-infra claim (9000 番台) は **レーン別サブバンド**を使う
#   (hub 裁定 2026-07-19, issue 0130): 9200=a / 9300=b / 9400=c / 9500=hub.
#   共有カウンタ SEQUENCE.9000 は未マージのレーン同士が同じ番号を引くため
#   1 日に 2 度衝突した (9163, 9164). 9000-9199 は既存分の歴史的レンジ.
# - SEQUENCE ファイルは mkdir 原子ロックで保護 (macOS に flock(1) が無いため)
# - slug は ASCII (小文字英数字 + ハイフン) 必須, ファイル名で使う
# - title は自由 (日本語可), frontmatter と H1 に入る
# - 作成したファイルと SEQUENCE は自動で `git add` する (commit はしない)
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: bin/new-issue [--base N] <slug> <title>

  --base N  採番レンジの基点 (省略時 $ODD_ISSUE_BASE, 既定 0). 100 の倍数.
            1000 の倍数 → 幅 1000 (0=main, 1000=lane a, 2000=b, 3000=c),
            それ以外    → 幅 100  (9200=a / 9300=b / 9400=c / 9500=hub の
                                   shared-infra claim サブバンド)
  slug      ASCII 小文字英数字 + ハイフン (例: bg-s1-lem-1-7b-sorry)
  title     自由形式 (日本語可, 例: "BG §1 Lem 1.7(b) sorry を埋める")

例:
  bin/new-issue bg-s1-lem-1-7b-sorry "BG §1 Lem 1.7(b) sorry を埋める"
  bin/new-issue --base 1000 pf-s10-thm-x "Peterfalvi §10 Thm X を形式化"
  bin/new-issue --base 9200 dedup-foo-bar "shared infra の重複を解消" # lane a の claim
EOF
  exit 1
}

base="${ODD_ISSUE_BASE:-0}"
if [[ "${1:-}" == "--base" ]]; then
  [[ $# -ge 3 ]] || usage
  base="$2"
  shift 2
fi

[[ $# -eq 2 ]] || usage

slug="$1"
title="$2"

if ! [[ "$base" =~ ^[0-9]+$ ]]; then
  echo "Error: --base は非負整数 (got: '$base')" >&2
  exit 1
fi
if (( base % 100 != 0 )); then
  echo "Error: --base は 100 の倍数 (got: '$base'). レンジ重複を防ぐため" >&2
  exit 1
fi
# base 9000 は凍結 (hub 裁定 2026-07-19, issue 0130): 幅 1000 ゆえレンジ [9000,10000) が
# レーン別サブバンド 9200/9300/9400/9500 を丸ごと飲み込み、実在ファイル走査が他レーンの
# 番号を拾って衝突する。shared-infra claim は必ずレーン別サブバンドから採る。
if (( base == 9000 )); then
  cat >&2 <<'FROZEN'
Error: --base 9000 は凍結レンジ (9000-9199 = 2026-07-19 以前の shared-infra claim の履歴).
       shared-infra claim はレーン別サブバンドを使う:
         lane a → --base 9200   lane b → --base 9300
         lane c → --base 9400   hub    → --base 9500
       (理由と経緯: issues/closed/0130-*.md, notes/meta/issue_management.md)
FROZEN
  exit 1
fi
# レンジ幅: 1000 の倍数 → 1000 (レーン本体), それ以外の 100 の倍数 → 100
# (= 9000 番台 shared-infra claim をレーン別サブバンドに割るための細分割.
#  9200=a / 9300=b / 9400=c / 9500=hub, 9600 以降は将来レーン・枯渇時の再割当用)
if (( base % 1000 == 0 )); then range_width=1000; else range_width=100; fi

if [[ ! "$slug" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  echo "Error: slug は小文字英数字 + ハイフンのみ (got: '$slug')" >&2
  exit 1
fi

if [[ -z "$title" ]]; then
  echo "Error: title が空" >&2
  exit 1
fi

ROOT="$(git rev-parse --show-toplevel)"
ISSUES_DIR="$ROOT/issues"
# レンジごとに SEQUENCE ファイルを分ける (base 0 は従来どおり SEQUENCE)
if [[ "$base" -eq 0 ]]; then
  SEQ_FILE="$ISSUES_DIR/SEQUENCE"
else
  SEQ_FILE="$ISSUES_DIR/SEQUENCE.$base"
fi
LOCK_DIR="$ISSUES_DIR/.lock"
RANGE_END=$((base + range_width))   # 排他上限 (幅は上の range_width)

[[ -d "$ISSUES_DIR" ]] || { echo "Error: $ISSUES_DIR が無い" >&2; exit 1; }

# Acquire lock (mkdir is atomic on POSIX)
attempts=0
while ! mkdir "$LOCK_DIR" 2>/dev/null; do
  attempts=$((attempts + 1))
  if [[ $attempts -gt 50 ]]; then
    echo "Error: ロック取得に失敗 (5s 経過). 古い $LOCK_DIR があれば rmdir で除去" >&2
    exit 1
  fi
  sleep 0.1
done
trap 'rmdir "$LOCK_DIR" 2>/dev/null || true' EXIT

# SEQUENCE 初期値: base 0 はファイル必須 (既存), base>0 は無ければ base-1 で遅延初期化
if [[ -f "$SEQ_FILE" ]]; then
  current=$(cat "$SEQ_FILE")
elif [[ "$base" -gt 0 ]]; then
  current=$((base - 1))
else
  echo "Error: $SEQ_FILE が無い (内容は単一整数)" >&2
  exit 1
fi

if ! [[ "$current" =~ ^[0-9]+$ ]]; then
  echo "Error: SEQUENCE の中身が整数ではない: '$current'" >&2
  exit 1
fi

# SEQUENCE は「ブランチごとに存在するただのカウンタ」なので単独では信用しない:
#   (a) レーン worktree ごとに複製が増分される共有レンジ (9000) で同番号が同時に出る
#   (b) レーン再作成やマージ解決でカウンタが過去値へ巻き戻る (実害: 1036-1038, 9125/9132/9133)
# ⟹ 実在する issue ファイルの最大番号も走査し, 大きい方を採用する (hub 裁定 2026-07-18).
max_file=0
for d in "$ISSUES_DIR" "$ISSUES_DIR/pending" "$ISSUES_DIR/closed"; do
  [[ -d "$d" ]] || continue
  for f in "$d"/[0-9][0-9][0-9][0-9]-*.md; do
    [[ -e "$f" ]] || continue
    n=$(basename "$f"); n="${n%%-*}"; n=$((10#$n))
    if (( n >= base && n < RANGE_END && n > max_file )); then max_file=$n; fi
  done
done
if (( max_file > current )); then current=$max_file; fi

next=$((current + 1))

# レンジ使い切りチェック
if [[ "$next" -ge "$RANGE_END" ]]; then
  echo "Error: レンジ [$base, $RANGE_END) を使い切った (next=$next)." >&2
  echo "       採番レンジの再分割を検討 (notes/meta/issue_management.md)." >&2
  exit 1
fi

padded=$(printf "%04d" "$next")
filename="${padded}-${slug}.md"
filepath="$ISSUES_DIR/$filename"

# 同名 (= 同 slug の取り直し) を防ぐ
if [[ -e "$filepath" ]] \
  || [[ -e "$ISSUES_DIR/pending/$filename" ]] \
  || [[ -e "$ISSUES_DIR/closed/$filename" ]]; then
  echo "Error: $filename はすでに存在" >&2
  exit 1
fi

# 番号のみの衝突も弾く (slug が違えば通ってしまう穴を塞ぐ; 上の max 走査の保険)
for d in "$ISSUES_DIR" "$ISSUES_DIR/pending" "$ISSUES_DIR/closed"; do
  for f in "$d/${padded}-"*.md; do
    [[ -e "$f" ]] || continue
    echo "Error: 番号 $padded は既に使用済: $f" >&2
    echo "       SEQUENCE.$base が巻き戻っているか, 共有レンジで他レーンと衝突した可能性." >&2
    exit 1
  done
done

# YAML frontmatter 用に title をダブルクォート文字列としてエスケープ
title_yaml=$(printf '%s' "$title" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
today=$(date +%Y-%m-%d)

cat > "$filepath" <<EOF
---
id: $next
slug: $slug
title: "$title_yaml"
created: $today
---

# $title

## 背景

<!-- なぜこの issue を立てたか. ROADMAP / notes / コミット等への参照. -->

## やること

- [ ]

## 完了条件

<!-- 何をもって closed とするか. 例: 該当 sorry が消える / lake build が通る / ノート x.md を書く -->

## 参照

<!-- 関連 issue / PR / ファイル / コミット. -->
EOF

echo "$next" > "$SEQ_FILE"

git -C "$ROOT" add "$SEQ_FILE" "$filepath"

echo "Created: issues/$filename (range base $base)"
echo "Staged:  $SEQ_FILE, $filepath"
