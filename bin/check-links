#!/usr/bin/env python3
"""Report broken relative links in the repository's Markdown files.

Links inside fenced code blocks and inline code spans are ignored (they are
illustrative, not navigable).  A `path.lean:123` line-number suffix is stripped
before the existence check, matching the repo's `file:line` citation convention.

Usage:  bin/check-links [--verbose]
Exit code 1 if any broken link is found.
"""
import os, re, subprocess, sys

ROOT = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                      capture_output=True, text=True, check=True).stdout.strip()
LINK = re.compile(r'\[([^\]\n]*)\]\(([^)\s]+?)(?:\s+"[^"]*")?\)')
CODE = re.compile(r'`[^`\n]*`')
LINENO = re.compile(r'(\.(?:lean|md|py|toml|sh|yml|yaml)):\d+(?:-\d+)?$')


def broken_links():
    files = subprocess.run(["git", "ls-files", "*.md"], cwd=ROOT,
                           capture_output=True, text=True).stdout.split()
    out = []
    for f in files:
        path = os.path.join(ROOT, f)
        fence = False
        with open(path, encoding="utf-8") as fh:
            for i, line in enumerate(fh, 1):
                if line.lstrip().startswith("```"):
                    fence = not fence
                    continue
                if fence:
                    continue
                for m in LINK.finditer(CODE.sub(lambda c: " " * len(c.group(0)), line)):
                    target = m.group(2)
                    if target.startswith(("http://", "https://", "mailto:", "#")):
                        continue
                    t = LINENO.sub(r"\1", target.split("#")[0])
                    if not t:
                        continue
                    if not os.path.exists(os.path.normpath(os.path.join(os.path.dirname(path), t))):
                        out.append((f, i, m.group(1), target))
    return out, len(files)


def main():
    bad, scanned = broken_links()
    for f, i, label, target in bad:
        print(f"{f}:{i}\t{target}\t[{label}]")
    print(f"--- {len(bad)} broken / {scanned} markdown files", file=sys.stderr)
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
